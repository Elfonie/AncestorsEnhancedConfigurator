<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AncestorsEnhanced.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="820"
        x:Class="AncestorsEnhanced.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        MinWidth="760"
        MinHeight="640"
        Icon="/Assets/aec-icon.ico"
        Title="Ancestors Enhanced Configurator">

  <Grid ColumnDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
    <ProgressBar Grid.ColumnSpan="2" ZIndex="1000"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Stretch"
                 Height="3"
                 Foreground="#FF5A00"
                 Background="Transparent"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsAnyOperationRunning}" />
    <!-- Sidebar navigation -->
    <Border Grid.Column="0"
            Width="200"
            Padding="16,18"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="6">
        <StackPanel Spacing="1" Margin="0,0,0,14">
          <TextBlock Text="{Binding ProductName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
          <TextBlock Text="Configurator" FontSize="12" Foreground="#7A877A" TextWrapping="Wrap" />
        </StackPanel>
        <ToggleButton Classes="nav"
                      Command="{Binding ShowHomeCommand}"
                      IsChecked="{Binding ShowHomeView, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Content="Home" />
        <ToggleButton Classes="nav"
                      Command="{Binding ShowGraphicsCommand}"
                      IsChecked="{Binding IsGraphicsSectionActive, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                       Content="Graphics" />
        <ToggleButton Classes="nav"
                      Command="{Binding ShowSaveGamesCommand}"
                      IsChecked="{Binding ShowSaveGamesView, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                       Content="Saves" />
        <ToggleButton Classes="nav"
                      Command="{Binding ShowGameplayCommand}"
                      IsChecked="{Binding ShowGameplayView, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Content="Gameplay" />
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="6">
        <ToggleButton Classes="nav"
                      Command="{Binding ShowSettingsCommand}"
                      IsChecked="{Binding IsSettingsSectionActive, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Content="Settings" />
      </StackPanel>
      </Grid>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Grid.Column="1"
            Padding="22,14"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding PageContextLabel}"
                     FontSize="23"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="{Binding PageContextLabel}"
                     FontSize="12"
                     Foreground="#748691" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="Reload"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsAnyOperationRunning}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="22,18"
                  Spacing="12"
                  MaxWidth="1380"
                  HorizontalAlignment="Stretch">

        <StackPanel IsVisible="{Binding ShowHomeView}" Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding HomeTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="{Binding InstallationDetails}" Foreground="#9CB0BC" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,8" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding DetectionColor}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="9" Height="9" Fill="{Binding DetectionDotColor}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DetectionStatus}" FontWeight="SemiBold" Foreground="{Binding DetectionColor}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Padding="18" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="5">
                <TextBlock Text="RECOMMENDED FOR YOUR PC" FontSize="11" FontWeight="SemiBold" Foreground="#82939D" />
                <TextBlock Text="{Binding HardwareDiagnostics.Recommendation.PresetName}" FontSize="21" FontWeight="SemiBold" Foreground="#EBF0F3" />
                <TextBlock Text="{Binding HardwareDiagnostics.Recommendation.Description}" MaxWidth="650" TextWrapping="Wrap" FontSize="12" Foreground="#9CB0BC" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <Button Classes="PrimaryAction" Content="Review recommended tweak" Command="{Binding LoadHardwareRecommendationCommand}" IsVisible="{Binding CanStageHardwareRecommendation}" />
                <Button Content="Check GPU details" Command="{Binding RunDetailedHardwareDetectionCommand}" IsVisible="{Binding CanShowHardwareScanAction}" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <Border Padding="16" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="5"><TextBlock Text="GRAPHICS" FontSize="11" FontWeight="SemiBold" Foreground="#82939D" /><TextBlock Text="{Binding HomeGraphicsSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><Button Content="Change graphics" Command="{Binding ShowGraphicsCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="5"><TextBlock Text="GAMEPLAY" FontSize="11" FontWeight="SemiBold" Foreground="#82939D" /><TextBlock Text="{Binding HomeGameplaySummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><Button Content="Choose difficulty" Command="{Binding ShowGameplayCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <Border Grid.Row="1" Padding="16" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="5"><TextBlock Text="SAVES &amp; BACKUPS" FontSize="11" FontWeight="SemiBold" Foreground="#82939D" /><TextBlock Text="{Binding HomeSavesSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><Button Content="Manage saves" Command="{Binding ShowSaveGamesCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="5"><TextBlock Text="CURRENT CHANGES" FontSize="11" FontWeight="SemiBold" Foreground="#82939D" /><TextBlock Text="{Binding PendingSummary}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding PendingDetails}" IsVisible="{Binding HasPendingChanges}" FontSize="12" TextWrapping="Wrap" Foreground="#9CB0BC" /></StackPanel>
            </Border>
          </Grid>
        </StackPanel>


        <StackPanel IsVisible="{Binding ShowGraphicsView}" Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <Border Padding="14,10"
                  CornerRadius="7"
                  BorderThickness="1"
                  BorderBrush="{Binding DetectionColor}"
                  Background="{DynamicResource SurfaceBrush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Ellipse Width="9" Height="9" Fill="{Binding DetectionDotColor}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding DetectionStatus}"
                           FontWeight="SemiBold"
                           Foreground="{Binding DetectionColor}" />
                <TextBlock Text="{Binding InstallationDetails}"
                           FontSize="12"
                           Foreground="#9CB0BC" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  Padding="4"
                  CornerRadius="7"
                  Background="{DynamicResource RaisedSurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton Classes="mode"
                            Command="{Binding ShowSimpleCommand}"
                            IsChecked="{Binding IsSimpleMode, Mode=OneWay}"
                            Content="Simple" />
              <ToggleButton Classes="mode"
                            Command="{Binding ShowAdvancedCommand}"
                            IsChecked="{Binding IsAdvancedMode, Mode=OneWay}"
                            Content="Advanced" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Padding="14,11"
                CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,320" ColumnSpacing="18">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding ViewModeTitle}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="#EBF0F3" />
              <TextBlock Text="{Binding ViewModeDescription}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="#81929D" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     IsVisible="{Binding IsAdvancedMode}"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="Search settings…"
                     VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="#4A5A23" BorderThickness="1"
                IsVisible="{Binding HasGamePreset}">
          <StackPanel Spacing="3">
            <TextBlock FontWeight="SemiBold" Foreground="#E6ECEF">
              <Run Text="Game preset: " /><Run Text="{Binding GamePresetName}" Foreground="#B4D941" />
              <Run Text=" · Custom overrides: " /><Run Text="{Binding CustomOverrideCount}" Foreground="#FF5A00" />
            </TextBlock>
            <TextBlock Text="Custom settings replace parts of the selected game preset. Settings that still come from the preset show their Low/Medium/High value; overridden settings show their custom value." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="Choose a graphics goal" FontWeight="SemiBold" Foreground="#E6ECEF" />
                <TextBlock Text="Presets change only their listed settings. Nothing is written until you review it." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Save as profile" Command="{Binding CreateProfileFromGraphicsCommand}" />
                <Button Content="Manage profiles" Command="{Binding ShowProfilesCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Quality &amp; image style" FontSize="12" Foreground="#B8D7E5" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding PrimaryGraphicsPresets}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BuiltInGraphicsPresetViewModel">
                  <Button Margin="0,0,8,6" MinHeight="54" Command="{Binding $parent[Window].DataContext.LoadBuiltInGraphicsPresetCommand}" CommandParameter="{Binding}">
                    <StackPanel Spacing="1"><TextBlock Text="{Binding Category}" FontSize="10" Foreground="#78909C" /><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" FontSize="11" /></StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="More hardware-specific tweaks" FontSize="12" Foreground="#9CB0BC">
              <ItemsControl ItemsSource="{Binding AdditionalGraphicsTweaks}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuiltInGraphicsPresetViewModel">
                    <Button Margin="0,0,8,6" MinHeight="48" Command="{Binding $parent[Window].DataContext.LoadBuiltInGraphicsPresetCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="1"><TextBlock Text="{Binding Category}" FontSize="10" Foreground="#78909C" /><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding Summary}" FontSize="11" /></StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Classes="mode" Command="{Binding ShowAllGraphicsCommand}" IsChecked="{Binding IsAllGraphicsFilter}" Content="All" />
          <ToggleButton Classes="mode" Command="{Binding ShowModifiedGraphicsCommand}" IsChecked="{Binding IsModifiedGraphicsFilter}" Content="Modified" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding FeatureGroups}"
                      IsEnabled="{Binding CanEditSettings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FeatureGroupRowViewModel">
              <Border Margin="0,0,0,8"
                      Classes="SettingCard">
                <Grid RowDefinitions="Auto,Auto">
                  <Button Classes="CardHeader"
                          Command="{Binding ToggleExpandedCommand}"
                          AutomationProperties.Name="{Binding Name}"
                          Padding="14,10"
                          MinHeight="42"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0">
                    <Grid ColumnDefinitions="4,*,Auto,22" ColumnSpacing="12" IsHitTestVisible="False">
                      <Border Background="{Binding AccentColor}" CornerRadius="2" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="#788892" />
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#E6ECEF" />
                        <TextBlock Text="{Binding Description}" IsVisible="{Binding ShowDescription}" FontSize="12" TextWrapping="Wrap" Foreground="#82939E" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                        <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="280" FontWeight="SemiBold" Foreground="#E8E4D9" />
                        <TextBlock Text="{Binding SettingCount}" HorizontalAlignment="Right" FontSize="11" Foreground="#74838D" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding Chevron}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B9AA4" />
                    </Grid>
                  </Button>

                  <Border Grid.Row="1"
                          CornerRadius="0,0,9,9"
                          ClipToBounds="True"
                          IsVisible="{Binding IsExpanded}">
                    <StackPanel>
                    <Button Content="Reset custom overrides in this group"
                            Command="{Binding $parent[Window].DataContext.ResetGraphicsGroupCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding HasResettableChanges}"
                            HorizontalAlignment="Right"
                            Margin="14,8,14,4" />
                    <ItemsControl ItemsSource="{Binding Settings}">
                      <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FeatureSettingRowViewModel">
                        <Border Padding="14,16"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="#1A221A"
                                BorderThickness="0,1,0,0"
                                ToolTip.Tip="{Binding Description}">
                          <Grid RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="18"
                                MinHeight="46">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Name}"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#E2E8EB" />
                              <TextBlock Text="{Binding Description}"
                                         IsVisible="{Binding ShowDescription}"
                                         TextWrapping="Wrap"
                                         FontSize="12"
                                         Foreground="#81929D" />
                              <TextBlock Text="{Binding TechnicalKey}"
                                         IsVisible="{Binding ShowTechnicalDetails}"
                                         FontSize="12"
                                         Foreground="#6F828D" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Spacing="1">
                              <TextBlock Text="{Binding ValueLabel}"
                                         HorizontalAlignment="Right"
                                         FontSize="11"
                                         Foreground="#657680" />
                              <TextBlock Text="{Binding Value}"
                                         HorizontalAlignment="Right"
                                         TextAlignment="Right"
                                         TextWrapping="Wrap"
                                         MaxWidth="140"
                                         FontWeight="SemiBold"
                                         Foreground="#E8E4D9" />
                            </StackPanel>

                            <ContentControl Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Content="{Binding Editor}"
                                            IsVisible="{Binding IsEditable}"
                                            HorizontalAlignment="Stretch"
                                            MaxWidth="520"
                                            Margin="0,12,0,0"
                                            VerticalAlignment="Center">
                              <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:SettingEditorViewModel">
                                  <Grid>
                                    <ToggleSwitch IsVisible="{Binding IsPresence}"
                                                  IsChecked="{Binding UseCustomValue, Mode=TwoWay}"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Skip startup videos"
                                                  Content="Skip startup videos" />

                                    <Grid IsVisible="{Binding IsRegularEditor}"
                                          ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12">
                                      <CheckBox IsChecked="{Binding UseCustomValue, Mode=TwoWay}"
                                                IsVisible="{Binding ShowOverrideToggle}"
                                                VerticalAlignment="Center"
                                                Content="Use custom value" />

                                      <Grid Grid.Column="1"
                                            IsEnabled="{Binding IsCustomEditorEnabled}"
                                            IsVisible="{Binding ShowValueEditor}">
                                        <ToggleSwitch IsVisible="{Binding IsToggle}"
                                                      IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                                                      AutomationProperties.Name="Value"
                                                      HorizontalAlignment="Right" />

                                        <Grid IsVisible="{Binding IsNumber}"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="7">
                                          <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay}"
                                                         Minimum="{Binding Minimum}"
                                                         Maximum="{Binding Maximum}"
                                                         Increment="{Binding Increment}"
                                                         FormatString="0.####"
                                                         AutomationProperties.Name="Value"
                                                         HorizontalAlignment="Stretch" />
                                          <TextBlock Grid.Column="1"
                                                     Text="{Binding Unit}"
                                                     IsVisible="{Binding HasUnit}"
                                                     VerticalAlignment="Center"
                                                     Foreground="#82939E" />
                                        </Grid>

                                        <ComboBox IsVisible="{Binding IsChoice}"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                          <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingChoiceViewModel">
                                              <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                          </ComboBox.ItemTemplate>
                                        </ComboBox>
                                      </Grid>

                                      <Border Grid.Column="1"
                                              IsVisible="{Binding ShowUnknownGameValue}"
                                              Padding="10,7"
                                              CornerRadius="5"
                                              Background="#182127"
                                              BorderBrush="#2A363E"
                                              BorderThickness="1">
                                        <TextBlock Text="Runtime value is not stored in the game config"
                                                   TextWrapping="Wrap"
                                                   Foreground="#82939E" />
                                      </Border>

                                      <TextBlock Grid.Column="1"
                                                 IsVisible="{Binding HasUnsupportedCurrentValue}"
                                                 Text="Unsupported value. Disable Use custom value to reset it."
                                                 TextWrapping="Wrap"
                                                 Foreground="#D6BC84" />
                                    </Grid>
                                  </Grid>
                                </DataTemplate>
                              </ContentControl.ContentTemplate>
                            </ContentControl>

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    IsVisible="{Binding IsReadOnly}"
                                    Padding="9,5"
                                    Margin="0,12,0,0"
                                    CornerRadius="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceBrush}">
                              <TextBlock Text="{Binding ReadOnlyLabel}" FontSize="12" Foreground="#71828D" TextWrapping="Wrap" />
                            </Border>

                            <Expander Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      IsVisible="{Binding HasPresetValues}"
                                      Margin="0,9,0,0"
                                      Header="Game preset values"
                                      FontSize="12"
                                      Foreground="#91A4AF">
                              <StackPanel Margin="0,8,0,2" Spacing="8">
                                <TextBlock Text="{Binding PresetExplanation}"
                                           TextWrapping="Wrap"
                                           Foreground="#81929D" />
                                <ItemsControl ItemsSource="{Binding PresetValues}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingPresetValueRowViewModel">
                                      <Border Margin="0,0,8,0"
                                              Padding="10,7"
                                              CornerRadius="5"
                                              Background="#172027"
                                              BorderBrush="#29353E"
                                              BorderThickness="1">
                                        <StackPanel Spacing="2">
                                          <TextBlock Text="{Binding Name}"
                                                     FontSize="11"
                                                     Foreground="#71828D" />
                                          <TextBlock Text="{Binding Value}"
                                                     FontWeight="SemiBold"
                                                     Foreground="#C9D4DA" />
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Expander>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding HasNoSearchResults}"
                Padding="18"
                CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
          <StackPanel Spacing="3" HorizontalAlignment="Center">
            <TextBlock Text="No matching settings"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#D6DEE3" />
            <TextBlock Text="Try a setting name such as shadow or a renderer key"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="#71828D" />
          </StackPanel>
        </Border>

        <Expander Header="Files and diagnostics"
                  IsExpanded="False"
                  IsVisible="False"
                  FontSize="14"
                  Foreground="#D6DEE3">
          <StackPanel Margin="0,10,0,0" Spacing="10">
            <Border Padding="13" CornerRadius="7" Background="{DynamicResource SurfaceBrush}">
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="Installation" Foreground="#71828D" />
                <TextBlock Grid.Column="1" Text="{Binding InstallationPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="User data" Foreground="#71828D" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserDataPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="System.sav" Foreground="#71828D" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BinarySettingsPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Status" Foreground="#71828D" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BinarySettingsStatus}" TextWrapping="Wrap" Foreground="#C3A66A" />
              </Grid>
            </Border>

            <Expander Header="Configuration files">
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ConfigurationFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigurationFileRowViewModel">
                    <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                      <Grid ColumnDefinitions="170,*,210">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#8B9AA4" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#B4D941" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="Raw INI entries">
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingRowViewModel">
                    <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                      <Grid ColumnDefinitions="120,2*,2*,60" ColumnSpacing="8">
                        <TextBlock Text="{Binding Source}" Foreground="#71828D" />
                        <TextBlock Grid.Column="1" Text="{Binding Setting}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" Foreground="#E8E4D9" />
                        <TextBlock Grid.Column="3" Text="{Binding Location}" Foreground="#71828D" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="PAK packages">
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding PakFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PakFileRowViewModel">
                    <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                      <Grid ColumnDefinitions="250,180,*">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#8B9AA4" />
                        <TextBlock Grid.Column="2" Text="{Binding Classification}" Foreground="#C7B98C" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="Inspection notes">
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NoticeRowViewModel">
                    <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                      <Grid ColumnDefinitions="90,*">
                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="#D6BC84" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Expander>
        <Border IsVisible="{Binding IsAdvancedMode}" Padding="12,10" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Need technical information? Open Diagnostics for files, PAKs and inspection notes." FontSize="12" Foreground="#9CB0BC" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Open diagnostics" Command="{Binding ShowDiagnosticsCommand}" />
          </Grid>
        </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowSaveGamesView}" Spacing="12">
          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="Save Games" FontSize="18" FontWeight="SemiBold" Foreground="#EBF0F3" />
                <TextBlock Text="Five slots · checkpoints · restore" FontSize="12" Foreground="#81929D" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Padding="14,11"
                  CornerRadius="7"
                  Background="#2A1F16"
                  BorderBrush="#6B4A26"
                  BorderThickness="1"
                  IsVisible="{Binding SaveManager.HasToolSettingsWarning}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <TextBlock Text="{Binding SaveManager.ToolSettingsWarning}"
                         Foreground="#E8C08A"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="Reset auto-backup settings"
                      Command="{Binding SaveManager.ResetToolSettingsCommand}"
                      IsEnabled="{Binding SaveManager.CanResetToolSettings}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1"
                    IsVisible="{Binding IsSaveManagerAvailable}"
                    IsEnabled="{Binding SaveManager.CanConfigureAutoBackup}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding SaveManager.IsWatchdogEnabled, Mode=TwoWay}"
                             OffContent="Off" OnContent="On"
                             AutomationProperties.Name="Enable Auto-Backup"
                             VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Enable Auto-Backup" FontWeight="SemiBold" Foreground="#E6ECEF" />
                <TextBlock Text="Creates a checkpoint when the game saves."
                           FontSize="12" Foreground="#82939D" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Minimum time between auto-backups:" FontSize="12" Foreground="#82939D" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding SaveManager.CooldownChoices}"
                            SelectedItem="{Binding SaveManager.CooldownMinutes, Mode=TwoWay}"
                            IsEnabled="{Binding SaveManager.IsWatchdogEnabled}"
                            Width="76" MinWidth="76" HorizontalAlignment="Left" />
                  <TextBlock Text="min" FontSize="12" Foreground="#82939D" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel IsVisible="{Binding IsSaveManagerAvailable}" Spacing="12">
          <Border Padding="14,10" CornerRadius="7" BorderThickness="1"
                  BorderBrush="{Binding SaveManager.StatusAccent}"
                  Background="{DynamicResource SurfaceBrush}"
                  IsVisible="True">
            <TextBlock Text="{Binding SaveManager.StatusMessage}" TextWrapping="Wrap" Foreground="{Binding SaveManager.StatusAccent}" />
          </Border>

          <Expander Header="{Binding SaveManager.CloudWarningTitle}" Padding="12,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="#3B3120" BorderThickness="1">
            <TextBlock Text="{Binding SaveManager.CloudWarning}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#D6BC84" FontSize="12" />
          </Expander>

          <Border Padding="12,10" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding SaveManager.BackupHealthAccent}" BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Text="Backup health" FontWeight="SemiBold" Foreground="#E6ECEF" />
              <TextBlock Text="{Binding SaveManager.BackupHealthSummary}" TextWrapping="Wrap" Foreground="{Binding SaveManager.BackupHealthAccent}" />
              <TextBlock Text="This checks what AEC could read during the latest scan. It does not claim a checkpoint was loaded successfully in-game."
                         IsVisible="{Binding SaveManager.HasBackupHealthWarning}" FontSize="12" Foreground="#D6BC84" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Padding="12,10" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,180" ColumnSpacing="10">
              <TextBox PlaceholderText="Search checkpoint name, note or origin"
                       Text="{Binding SaveManager.CheckpointSearchText}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SaveManager.CheckpointOriginFilters}"
                        SelectedItem="{Binding SaveManager.CheckpointOriginFilter, Mode=TwoWay}" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding SaveManager.Slots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveGameSlotViewModel">
                <Border Margin="0,0,0,8" Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#E6ECEF" />
                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#71828D" />
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#82939E" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CheckpointCount}" FontSize="12" Foreground="#82939E" />
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding CreateCheckpointCommand}" IsEnabled="{Binding CanSaveCheckpoint}" Content="Save checkpoint" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding VisibleCheckpoints}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SaveGameCheckpointViewModel">
                          <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Foreground="#E1E7EA" />
                                <TextBlock Text="{Binding CreatedLabel}" FontSize="12" Foreground="#82939D" />
                                <TextBlock Text="{Binding OriginLabel}" FontSize="12" Foreground="#B4D941" />
                                <TextBlock Text="{Binding SizeLabel}" FontSize="12" Foreground="#71828D" />
                                <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12" Foreground="#D6BC84" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <ToggleButton Content="★" ToolTip.Tip="Favorite" IsChecked="{Binding IsFavorite, Mode=TwoWay}" />
                                <Button Command="{Binding OpenRestoreConfirmCommand}" IsEnabled="{Binding CanRestore}" Content="Restore" Padding="12,6" IsVisible="{Binding !IsRestoreConfirmVisible}" />
                                <Button IsVisible="{Binding IsRestoreConfirmVisible}" IsEnabled="{Binding CanRestore}" Classes="PrimaryAction" Content="Confirm restore" Padding="12,6" Command="{Binding LoadCommand}" />
                                <Button IsVisible="{Binding IsRestoreConfirmVisible}" Classes="Ghost" Content="Cancel" Padding="12,6" Command="{Binding CancelRestoreConfirmCommand}" />
                                <Expander Header="More" FontSize="12">
                                  <StackPanel Spacing="5" Margin="0,6,0,0">
                                    <Button Content="Edit name / note" Command="{Binding ToggleMetadataEditorCommand}" />
                                    <Button Classes="Ghost" Content="Delete" Foreground="#D6BC84" Command="{Binding OpenDeleteConfirmCommand}" IsEnabled="{Binding CanDelete}" IsVisible="{Binding !IsDeleteConfirmVisible}" />
                                    <Button IsVisible="{Binding IsDeleteConfirmVisible}" Classes="DangerAction" Content="Yes, delete it" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
                                    <Button IsVisible="{Binding IsDeleteConfirmVisible}" Classes="Ghost" Content="Cancel" Command="{Binding CancelDeleteConfirmCommand}" />
                                  </StackPanel>
                                </Expander>
                              </StackPanel>
                            </Grid>
                            <StackPanel IsVisible="{Binding IsMetadataEditorVisible}" Spacing="6" Margin="0,8,0,0">
                              <TextBox PlaceholderText="Checkpoint name optional" Text="{Binding Title}" MaxLength="80" />
                              <TextBox PlaceholderText="Note optional" Text="{Binding Note}" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />
                            </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding ShowAllLabel}"
                            Command="{Binding ShowOlderCommand}"
                            IsVisible="{Binding HasHiddenCheckpoints}"
                            HorizontalAlignment="Left" Padding="8,4" Margin="-8,-4" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#FF5A00" FontSize="12" />
                    <Button Content="Show less"
                            Command="{Binding ShowRecentCommand}"
                            IsVisible="{Binding HasExpandedCheckpoints}"
                            HorizontalAlignment="Left" Padding="8,4" Margin="-8,-4" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#FF5A00" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding SaveManager.HasNoSlots}" Spacing="10" Margin="0,2,0,0">
            <Border Classes="SettingCard" Padding="16,14" CornerRadius="7" BorderThickness="1">
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="No save games found yet"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#E8E4D9" />
                <TextBlock Text="Start Ancestors once and create a save; then it appears here along with any checkpoints."
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#82939D" />
                <Button Classes="PrimaryAction"
                        Content="Scan for save games"
                        Command="{Binding SaveManager.RefreshCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
          </StackPanel>

          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  IsVisible="{Binding IsSaveManagerUnavailable}">
            <StackPanel Spacing="8">
              <TextBlock Text="Save management requires a supported, verified Ancestors installation and detected user data. If the game is running or recovery is pending, close it and reload."
                         TextWrapping="Wrap" Foreground="#82939D" />
              <Button Classes="PrimaryAction" Content="Scan again" Command="{Binding RefreshCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowGameplayView}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="Gameplay difficulty" FontSize="18" FontWeight="SemiBold" Foreground="#EBF0F3" />
              <TextBlock Text="Draft difficulty only · no save changes" FontSize="12" Foreground="#9CB0BC" />
            </StackPanel>
            <Border Grid.Column="1" Padding="4" CornerRadius="7" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton Classes="mode" Command="{Binding ShowGameplaySimpleCommand}" IsChecked="{Binding IsGameplaySimpleMode, Mode=OneWay}" Content="Simple" />
                <ToggleButton Classes="mode" Command="{Binding ShowGameplayAdvancedCommand}" IsChecked="{Binding IsGameplayAdvancedMode, Mode=OneWay}" Content="Advanced" />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel IsVisible="{Binding IsGameplaySimpleMode}" Spacing="12">
            <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1" IsVisible="{Binding HasGameplayDifficultyPresets}">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="Presets" FontWeight="SemiBold" Foreground="#B8D7E5" />
                  <TextBlock Text="Choose a starting point, then fine-tune below." FontSize="12" Foreground="#9CB0BC" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding GameplayDifficultyPresets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameplayDifficultyPresetViewModel">
                      <Border Padding="12,9" Margin="0,0,0,6" CornerRadius="6" Background="#10191F" BorderBrush="#344A56" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E6ECEF" />
                            <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" Foreground="#B4D941" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="Use as draft" Command="{Binding $parent[Window].DataContext.SelectGameplayPresetCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1" IsVisible="{Binding HasGameplaySimpleControls}">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="Simple controls" FontWeight="SemiBold" Foreground="#B8D7E5" />
                  <TextBlock Text="4 supported categories · 10% steps" FontSize="12" Foreground="#9CB0BC" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding GameplaySimpleControls}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameplayDifficultyControlViewModel">
                      <Border Padding="12,9" Margin="0,0,0,6" CornerRadius="6" Background="#10191F" BorderBrush="#344A56" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E6ECEF" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StockValue}" FontWeight="SemiBold" Foreground="#B4D941" TextAlignment="Right" />
                            <NumericUpDown Value="{Binding MultiplierPercent, Mode=TwoWay}" Minimum="50" Maximum="150" Increment="10" FormatString="{}{0}%" Width="118" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding DraftValue}" FontSize="11" Foreground="#71828D" HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding GameplayDraftStatus}" FontSize="12" Foreground="#D6BC84" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsGameplayAdvancedMode}" Spacing="12">
            <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1" IsVisible="{Binding HasGameplayResearchValues}">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="Advanced values" FontWeight="SemiBold" Foreground="#B8D7E5" />
                  <TextBlock Text="Technical values with direct static code evidence. They are separate because coupling them casually can create inconsistent vitality, wound or poison behaviour." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding GameplayResearchValues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameplayResearchValueViewModel">
                      <Border Padding="12,9" Margin="0,0,0,6" CornerRadius="6" Background="#10191F" BorderBrush="#344A56" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E6ECEF" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
                            <Expander Header="Technical details" FontSize="11" Foreground="#8FA3AE" Margin="0,3,0,0">
                              <StackPanel Spacing="2" Margin="0,5,0,0">
                                <TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="#71828D" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Editability}" FontSize="11" Foreground="#D6BC84" TextWrapping="Wrap" />
                              </StackPanel>
                            </Expander>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StockValue}" FontWeight="SemiBold" Foreground="#B4D941" HorizontalAlignment="Right" />
                            <TextBlock Text="Locked research" FontSize="11" Foreground="#71828D" HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Padding="14,11" CornerRadius="7" Background="#211C18" BorderBrush="{Binding GameplayReadiness.AccentColor}" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding GameplayReadiness.Title}" FontWeight="SemiBold" Foreground="#E8D5B5" />
              <TextBlock Text="{Binding GameplayReadiness.Description}" FontSize="12" Foreground="#E8D5B5" TextWrapping="Wrap" />
              <TextBlock Text="This page currently writes nothing." FontSize="12" Foreground="#E8D5B5" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowProfilesView}" Spacing="12">
          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Profiles" FontSize="18" FontWeight="SemiBold" Foreground="#EBF0F3" />
                <TextBlock Text="Save, share and review your graphics and future gameplay setup without changing save games." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Import profile" Click="ImportProfileClick" />
                <Button Classes="PrimaryAction" Content="Create profile" Command="{Binding StartCreatingProfileCommand}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="10,8" CornerRadius="6" Background="#17242B" BorderBrush="{Binding OperationAccent}" BorderThickness="1">
            <TextBlock Text="{Binding OperationMessage}" FontSize="12" Foreground="{Binding OperationAccent}" TextWrapping="Wrap" />
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1"
                  IsVisible="{Binding IsCreatingProfile}">
            <StackPanel Spacing="10" MaxWidth="660">
              <TextBlock Text="Create graphics profile" FontWeight="SemiBold" Foreground="#DCEEFF" />
              <TextBlock Text="This saves the current editable graphics setup, including direct game graphics values. Save games and external mods are never included." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
              <TextBlock Text="Set at least one graphics setting to Custom before saving a profile."
                         IsVisible="{Binding !HasCustomProfileSettings}"
                         FontSize="12" Foreground="#D6BC84" TextWrapping="Wrap" />
              <TextBox PlaceholderText="Profile name" Text="{Binding NewProfileName}" MaxLength="80" />
              <TextBox PlaceholderText="Short description optional" Text="{Binding NewProfileDescription}" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
              <StackPanel Spacing="3">
                <CheckBox IsChecked="True" IsEnabled="False" Content="Graphics settings" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCreatingProfileCommand}" />
                <Button Classes="PrimaryAction" Content="Save profile" Command="{Binding CreateProfileCommand}" IsEnabled="{Binding CanSaveProfile}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1"
                  IsVisible="{Binding HasImportedProfile}">
            <StackPanel Spacing="6">
              <TextBlock Text="Imported profile" FontWeight="SemiBold" Foreground="#DCEEFF" />
              <TextBlock Text="{Binding ImportedProfile.Name}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ImportedProfile.Description}" FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ImportedProfile.Contents}" FontSize="12" Foreground="#B4D941" />
              <TextBlock Text="{Binding ImportedProfile.SettingCount, StringFormat={}{0} settings checked}" FontSize="12" Foreground="#82939D" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Add to My profiles" Command="{Binding AddImportedProfileToLibraryCommand}" />
                <Button Classes="PrimaryAction" Content="Load for review" Command="{Binding LoadImportedProfileCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1"
                  IsVisible="{Binding !HasUserProfiles}">
            <StackPanel Spacing="5">
              <TextBlock Text="No saved profiles yet" FontWeight="SemiBold" Foreground="#B8D7E5" />
              <TextBlock Text="Create a profile from the current editable graphics setup or import a .aecprofile file. Loaded values are always reviewed before anything is applied." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="#211C18" BorderBrush="#765536" BorderThickness="1"
                  IsVisible="{Binding HasProfilePendingDeletion}">
            <StackPanel Spacing="8">
              <TextBlock Text="Delete this profile?" FontWeight="SemiBold" Foreground="#E8D5B5" />
              <TextBlock Text="{Binding ProfilePendingDeletion.Name, StringFormat=This permanently removes {0} from My profiles.}" FontSize="12" Foreground="#E8D5B5" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelProfileDeletionCommand}" />
                <Button Classes="DangerAction" Content="Delete profile" Command="{Binding ConfirmProfileDeletionCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1"
                  IsVisible="{Binding HasProfilePendingRename}">
            <StackPanel Spacing="8" MaxWidth="660">
              <TextBlock Text="Rename profile" FontWeight="SemiBold" Foreground="#DCEEFF" />
              <TextBlock Text="AEC first writes a validated renamed copy. Only then is the original removed, so a failed write cannot lose the profile." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
              <TextBox Text="{Binding RenamedProfileName}" MaxLength="80" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelProfileRenameCommand}" />
                <Button Classes="PrimaryAction" Content="Rename profile" Command="{Binding ConfirmProfileRenameCommand}" IsEnabled="{Binding CanConfirmProfileRename}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                  IsVisible="{Binding HasProfileComparison}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding ProfileComparisonName, StringFormat=Compare: {0}}" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" />
              <ItemsControl ItemsSource="{Binding ProfileComparisonRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileComparisonRowViewModel">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Text="{Binding CurrentValue}" Foreground="#9CB0BC" />
                      <TextBlock Grid.Column="2" Text="{Binding ProfileValue}" Foreground="#B4D941" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding UserProfiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UserProfileRowViewModel">
                <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EBF0F3" />
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Contents}" FontSize="12" Foreground="#B4D941" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                      <Button Classes="PrimaryAction" Content="Load profile" Click="LoadStoredProfileClick" />
                      <Expander Header="More" FontSize="12">
                        <StackPanel Spacing="5" Margin="0,6,0,0">
                          <Button Content="Rename" Command="{Binding $parent[Window].DataContext.RequestProfileRenameCommand}" CommandParameter="{Binding}" />
                          <Button Content="Duplicate" Command="{Binding $parent[Window].DataContext.DuplicateProfileCommand}" CommandParameter="{Binding}" />
                          <Button Content="Compare" Command="{Binding $parent[Window].DataContext.CompareProfileCommand}" CommandParameter="{Binding}" />
                          <Button Content="Export" Click="ExportProfileClick" />
                          <Button Classes="DangerAction" Content="Delete" Command="{Binding $parent[Window].DataContext.RequestProfileDeletionCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowSettingsView}" Spacing="12">
          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#EBF0F3" />
              <TextBlock Text="Accessibility options and maintenance for Ancestors Enhanced Configurator." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Profiles and support" FontWeight="SemiBold" Foreground="#EBF0F3" />
                <TextBlock Text="Manage saved graphics setups or open a diagnostic report when something needs troubleshooting." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Manage profiles" Command="{Binding ShowProfilesCommand}" />
                <Button Content="Open diagnostics" Command="{Binding ShowDiagnosticsCommand}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding IsHighContrastEnabled, Mode=TwoWay}"
                            OffContent="Off" OnContent="On"
                            AutomationProperties.Name="Use high contrast mode"
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="High contrast" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" />
                <TextBlock Text="Uses brighter text, clearer borders and a visible keyboard focus on AEC's shared surfaces. This does not change Ancestors, your save games or your graphics settings." FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding IsDiscordRichPresenceEnabled, Mode=TwoWay}"
                            OffContent="Off" OnContent="On"
                            AutomationProperties.Name="Share Discord Rich Presence"
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Discord Rich Presence" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" />
                <TextBlock Text="Optional. When enabled, AEC starts Discord's local SDK and reports that the Configurator is open. It is off by default." FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1"
                  IsVisible="{Binding IsSaveManagerAvailable}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding SaveManager.KeepRunningInTrayWhenClosing, Mode=TwoWay}"
                            IsEnabled="{Binding SaveManager.CanConfigureAutoBackup}"
                            OffContent="Off" OnContent="On"
                            AutomationProperties.Name="Keep running in tray when closing"
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Keep auto-backup running when I close the window" FontWeight="SemiBold" Foreground="#E6ECEF" />
                <TextBlock Text="When Auto-Backup is enabled, closing AEC hides it in the system tray instead of stopping it. You can open it again or choose Exit from the tray menu." FontSize="12" Foreground="#82939D" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="#211C18" BorderBrush="#765536" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="Ancestors Enhanced maintenance" FontWeight="SemiBold" Foreground="#E8D5B5" />
              <TextBlock Text="Remove Ancestors Enhanced from my game restores files changed by this Configurator to their state before you first used it. Your save games and other mods are not removed." FontSize="12" Foreground="#C7B98C" TextWrapping="Wrap" />
              <TextBlock Text="No removable Configurator changes were found." IsVisible="{Binding !HasRemovableToolChanges}" FontSize="12" Foreground="#9CB0BC" />
              <Button Command="{Binding RemoveToolChangesCommand}"
                      IsEnabled="{Binding CanRemoveToolChanges}"
                      HorizontalAlignment="Left"
                      Content="Remove Ancestors Enhanced from my game"
                      ToolTip.Tip="Shows every unchanged file that will be restored before anything is written." />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowDiagnosticsView}" Spacing="12">
          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold" Foreground="#EBF0F3" />
                <TextBlock Text="Read-only inspection data for support and conflict triage. Copying the report redacts Windows user paths." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Copy diagnostics" Click="CopyDiagnosticsClick" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="#17242B" BorderBrush="#344A56" BorderThickness="1">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
              <TextBlock Text="AEC status" Foreground="#71828D" />
              <TextBlock Grid.Column="1" Text="{Binding DetectionStatus}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Installation" Foreground="#71828D" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstallationDetails}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="System.sav" Foreground="#71828D" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BinarySettingsStatus}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="System" Foreground="#71828D" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SystemDiagnostics}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="CPU" Foreground="#71828D" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HardwareDiagnostics.Cpu}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Text="Memory" Foreground="#71828D" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HardwareDiagnostics.Memory}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" Text="GPU / VRAM" Foreground="#71828D" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding HardwareDiagnostics.Graphics}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="7" Text="Recommendation" Foreground="#71828D" />
              <StackPanel Grid.Row="7" Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding HardwareDiagnostics.Recommendation.PresetName}" FontWeight="SemiBold" Foreground="#B4D941" />
                <TextBlock Text="{Binding HardwareDiagnostics.Recommendation.Description}" Foreground="#9CB0BC" TextWrapping="Wrap" />
                <Button Content="Run detailed hardware detection" Command="{Binding RunDetailedHardwareDetectionCommand}" IsEnabled="{Binding CanRunDetailedHardwareDetection}" HorizontalAlignment="Left" />
                <Button Content="Stage recommended preset" Command="{Binding LoadHardwareRecommendationCommand}" IsEnabled="{Binding CanStageHardwareRecommendation}" HorizontalAlignment="Left" />
              </StackPanel>
              <TextBlock Grid.Row="8" Text="Hardware status" Foreground="#71828D" />
              <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding HardwareDiagnostics.Status}" Foreground="#D6BC84" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Expander Header="Configuration files">
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ConfigurationFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfigurationFileRowViewModel">
                  <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                    <Grid ColumnDefinitions="170,*,210">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#8B9AA4" />
                      <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#B4D941" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <Expander Header="PAK packages">
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding PakFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PakFileRowViewModel">
                  <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                    <Grid ColumnDefinitions="250,180,*">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#8B9AA4" />
                      <TextBlock Grid.Column="2" Text="{Binding Classification}" Foreground="#C7B98C" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <Expander Header="Inspection notes">
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Notices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoticeRowViewModel">
                  <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                    <Grid ColumnDefinitions="90,*">
                      <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="#D6BC84" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Grid.Column="1"
              IsVisible="{Binding ShowBottomBar}"
            Padding="16,10"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding PendingSummary}"
                     FontWeight="SemiBold"
                     Foreground="#E1E7EA" />
          <TextBlock Text="{Binding PendingDetails}"
                     IsVisible="{Binding HasPendingChanges}"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="#C7B98C" />
          <TextBlock Text="{Binding OperationMessage}"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="{Binding OperationAccent}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Command="{Binding RestoreGameDefaultsCommand}"
                  IsEnabled="{Binding CanRestoreGameDefaults}"
                  IsVisible="{Binding ShowGraphicsView}"
                  Margin="0,0,8,0"
                  Content="Use game graphics settings"
                  ToolTip.Tip="Removes only custom graphics values set in this Configurator. The graphics presets selected in the game will be used again." />
          <Button Command="{Binding RevertLastCommand}"
                  IsEnabled="{Binding CanUndo}"
                  IsVisible="{Binding ShowGraphicsView}"
                  Margin="0,0,8,0"
                  Padding="16,7"
                  Content="Undo last apply" />
          <Button Command="{Binding DiscardChangesCommand}"
                  IsVisible="{Binding ShowPendingActions}"
                  Margin="0,0,8,0"
                  Content="Discard" />
          <Button Command="{Binding OpenReviewCommand}"
                  Classes="PrimaryAction"
                  IsVisible="{Binding ShowPendingActions}"
                  Content="Review" />
        </WrapPanel>
      </Grid>
    </Border>
    </Grid>
    <Grid Grid.ColumnSpan="2"
            x:Name="ReviewOverlay"
            ZIndex="100"
            IsVisible="{Binding IsReviewingChanges}"
            Focusable="True"
            AutomationProperties.Name="Review changes">
      <Grid.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelReviewCommand}" />
      </Grid.KeyBindings>
      <Button Classes="Ghost" Background="#E60C1115"
              Command="{Binding CancelReviewCommand}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              BorderThickness="0"
              CornerRadius="0"
              Padding="0" />
      <Border MaxWidth="900"
              MaxHeight="580"
              Padding="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="9"
              Background="#15232C"
              BorderBrush="#3B7598"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
          <TextBlock Text="{Binding ReviewSummary}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#DCEEFF" />
          <TextBlock Grid.Row="1"
                     Text="{Binding ReviewDescription}"
                     Foreground="#8CA9BA" />
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid ColumnDefinitions="1.2*,1.2*,Auto,1.2*" ColumnSpacing="10" Margin="0,0,0,4">
                <TextBlock Text="Setting" FontSize="12" FontWeight="SemiBold" Foreground="#8CA9BA" />
                <TextBlock Grid.Column="1" Text="Current value" FontSize="12" FontWeight="SemiBold" Foreground="#8CA9BA" />
                <TextBlock Grid.Column="3" Text="New value" FontSize="12" FontWeight="SemiBold" Foreground="#8CA9BA" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ReviewChanges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeReviewRowViewModel">
                  <Border Margin="0,0,0,5" Padding="11" CornerRadius="5" Background="#10191F">
                    <Grid ColumnDefinitions="1.2*,1.2*,Auto,1.2*" ColumnSpacing="10">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TechnicalKey}" FontSize="11" Foreground="#687984" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" Foreground="#8E9DA6" />
                      <TextBlock Grid.Column="2" Text="→" Foreground="#71818C" />
                      <TextBlock Grid.Column="3" Text="{Binding After}" TextWrapping="Wrap" Foreground="#FF5A00" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button x:Name="ReviewCancelButton" Command="{Binding CancelReviewCommand}" Content="Cancel" />
            <Button Command="{Binding ConfirmApplyCommand}" Classes="PrimaryAction" Content="{Binding ConfirmReviewLabel}" />
          </StackPanel>
        </Grid>
        </Border>
    </Grid>
    <Grid Grid.ColumnSpan="2"
          ZIndex="110"
          IsVisible="{Binding IsOnboardingVisible}"
          Focusable="True"
          AutomationProperties.Name="Welcome to Ancestors Enhanced">
      <Border Background="#E60C1115" />
      <Border MaxWidth="650" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="9" Background="#15232C" BorderBrush="#3B7598" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding OnboardingTitle}" FontSize="21" FontWeight="SemiBold" Foreground="#DCEEFF" />
          <TextBlock Text="{Binding OnboardingDescription}" TextWrapping="Wrap" Foreground="#B8D7E5" />
          <TextBlock Text="You can open this Configurator safely: no game files change until you explicitly review and confirm a supported edit." FontSize="12" Foreground="#9CB0BC" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Skip" Command="{Binding SkipOnboardingCommand}" />
            <Button Classes="PrimaryAction" Content="{Binding OnboardingActionLabel}" Command="{Binding AdvanceOnboardingCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.ColumnSpan="2"
             ZIndex="90"
             Background="#1A000000"
             IsVisible="{Binding IsAnyOperationRunning}" />
  </Grid>
</Window>
