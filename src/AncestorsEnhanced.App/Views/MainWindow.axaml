<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AncestorsEnhanced.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="820"
        x:Class="AncestorsEnhanced.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180"
        Height="820"
        MinWidth="940"
        MinHeight="640"
        Title="Ancestors Enhanced Configurator">

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">
    <Border Grid.Row="0"
            Padding="22,14"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding ProductName}"
                     FontSize="23"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="{Binding Phase}"
                     FontSize="11"
                     Foreground="#748691" />
        </StackPanel>
        <Button Grid.Column="1"
                Command="{Binding RefreshCommand}"
                Padding="14,8"
                VerticalAlignment="Center"
                Content="Reload" />
        <ProgressBar Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Margin="0,9,0,0"
                     Height="3"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="22,18"
                  Spacing="12"
                  MaxWidth="1380"
                  HorizontalAlignment="Center">

        <Border Padding="4" CornerRadius="7" Background="#171F25" BorderBrush="#2B363F" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton Classes="mode"
                          Command="{Binding ShowGraphicsCommand}"
                          IsChecked="{Binding ShowGraphicsView, Mode=OneWay}"
                          Content="Graphics" />
            <ToggleButton Classes="mode"
                          Command="{Binding ShowSaveGamesCommand}"
                          IsChecked="{Binding ShowSaveGamesView, Mode=OneWay}"
                          Content="Save Games" />
            <ToggleButton Classes="mode"
                          Command="{Binding ShowCheatCommand}"
                          IsChecked="{Binding ShowCheatView, Mode=OneWay}"
                          Content="Cheats" />
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding ShowGraphicsView}" Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <Border Padding="14,10"
                  CornerRadius="7"
                  Background="#122A23"
                  BorderBrush="#275442"
                  BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Ellipse Width="9" Height="9" Fill="#62C9A7" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding DetectionStatus}"
                           FontWeight="SemiBold"
                           Foreground="#DDF4EC" />
                <TextBlock Text="{Binding InstallationDetails}"
                           FontSize="11"
                           Foreground="#80B8A5" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  Padding="4"
                  CornerRadius="7"
                  Background="#171F25"
                  BorderBrush="#2B363F"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton Classes="mode"
                            Command="{Binding ShowSimpleCommand}"
                            IsChecked="{Binding IsSimpleMode, Mode=OneWay}"
                            Content="Simple" />
              <ToggleButton Classes="mode"
                            Command="{Binding ShowAdvancedCommand}"
                            IsChecked="{Binding IsAdvancedMode, Mode=OneWay}"
                            Content="Advanced" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Padding="14,11"
                CornerRadius="7"
                Background="#151C22"
                BorderBrush="#273139"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,320" ColumnSpacing="18">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding ViewModeTitle}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="#EBF0F3" />
              <TextBlock Text="{Binding ViewModeDescription}"
                         FontSize="11"
                         Foreground="#81929D" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     IsVisible="{Binding IsAdvancedMode}"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="Search name or renderer key"
                     VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding FeatureGroups}"
                      IsEnabled="{Binding CanEditSettings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FeatureGroupRowViewModel">
              <Border Margin="0,0,0,8"
                      CornerRadius="7"
                      Background="#151C22"
                      BorderBrush="#273139"
                      BorderThickness="1"
                      ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto">
                  <Button Command="{Binding ToggleExpandedCommand}"
                          Padding="14,10"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0">
                    <Grid ColumnDefinitions="4,*,Auto,22" ColumnSpacing="12" MinHeight="42">
                      <Border Background="{Binding AccentColor}" CornerRadius="2" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#697B86" />
                        <TextBlock Text="{Binding Name}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#E6ECEF" />
                        <TextBlock Text="{Binding Description}"
                                   IsVisible="{Binding ShowDescription}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="#82939E" />
                      </StackPanel>
                      <StackPanel Grid.Column="2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Spacing="1">
                        <TextBlock Text="{Binding Summary}"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   MaxWidth="280"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding AccentColor}" />
                        <TextBlock Text="{Binding SettingCount}"
                                   HorizontalAlignment="Right"
                                   FontSize="9"
                                   Foreground="#647580" />
                      </StackPanel>
                      <TextBlock Grid.Column="3"
                                 Text="{Binding Chevron}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="#8B9AA4" />
                    </Grid>
                  </Button>

                  <ItemsControl Grid.Row="1"
                                IsVisible="{Binding IsExpanded}"
                                ItemsSource="{Binding Settings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FeatureSettingRowViewModel">
                        <Border Padding="14,11"
                                Background="#10171C"
                                BorderBrush="#222C33"
                                BorderThickness="0,1,0,0"
                                ToolTip.Tip="{Binding Description}">
                          <Grid RowDefinitions="Auto,Auto"
                                ColumnDefinitions="2*,190,330"
                                ColumnSpacing="18"
                                MinHeight="46">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Name}"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#E2E8EB" />
                              <TextBlock Text="{Binding Description}"
                                         IsVisible="{Binding ShowDescription}"
                                         TextWrapping="Wrap"
                                         FontSize="11"
                                         Foreground="#81929D" />
                              <TextBlock Text="{Binding TechnicalKey}"
                                         IsVisible="{Binding ShowTechnicalDetails}"
                                         FontSize="10"
                                         Foreground="#5F7480" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Spacing="1">
                              <TextBlock Text="{Binding ValueLabel}"
                                         HorizontalAlignment="Right"
                                         FontSize="9"
                                         Foreground="#657680" />
                              <TextBlock Text="{Binding Value}"
                                         HorizontalAlignment="Right"
                                         TextAlignment="Right"
                                         TextWrapping="Wrap"
                                         MaxWidth="190"
                                         FontWeight="SemiBold"
                                         Foreground="{Binding AccentColor}" />
                            </StackPanel>

                            <ContentControl Grid.Column="2"
                                            Content="{Binding Editor}"
                                            IsVisible="{Binding IsEditable}"
                                            VerticalAlignment="Center">
                              <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:SettingEditorViewModel">
                                  <Grid>
                                    <ToggleSwitch IsVisible="{Binding IsPresence}"
                                                  IsChecked="{Binding UseCustomValue, Mode=TwoWay}"
                                                  HorizontalAlignment="Right"
                                                  Content="Skip startup videos" />

                                    <Grid IsVisible="{Binding IsRegularEditor}"
                                          ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12">
                                      <CheckBox IsChecked="{Binding UseCustomValue, Mode=TwoWay}"
                                                IsVisible="{Binding ShowOverrideToggle}"
                                                VerticalAlignment="Center"
                                                Content="Override" />

                                      <Grid Grid.Column="1"
                                            IsEnabled="{Binding IsCustomEditorEnabled}"
                                            IsVisible="{Binding ShowValueEditor}">
                                        <ToggleSwitch IsVisible="{Binding IsToggle}"
                                                      IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                                                      HorizontalAlignment="Right" />

                                        <Grid IsVisible="{Binding IsNumber}"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="7">
                                          <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay}"
                                                         Minimum="{Binding Minimum}"
                                                         Maximum="{Binding Maximum}"
                                                         Increment="{Binding Increment}"
                                                         FormatString="0.####"
                                                         HorizontalAlignment="Stretch" />
                                          <TextBlock Grid.Column="1"
                                                     Text="{Binding Unit}"
                                                     IsVisible="{Binding HasUnit}"
                                                     VerticalAlignment="Center"
                                                     Foreground="#82939E" />
                                        </Grid>

                                        <ComboBox IsVisible="{Binding IsChoice}"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                          <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingChoiceViewModel">
                                              <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                          </ComboBox.ItemTemplate>
                                        </ComboBox>
                                      </Grid>

                                      <Border Grid.Column="1"
                                              IsVisible="{Binding ShowUnknownGameValue}"
                                              Padding="10,7"
                                              CornerRadius="5"
                                              Background="#182127"
                                              BorderBrush="#2A363E"
                                              BorderThickness="1">
                                        <TextBlock Text="Runtime value is not stored in the game config"
                                                   TextWrapping="Wrap"
                                                   Foreground="#82939E" />
                                      </Border>

                                      <TextBlock Grid.Column="1"
                                                 IsVisible="{Binding HasUnsupportedCurrentValue}"
                                                 Text="Unsupported value. Clear Custom to reset it."
                                                 TextWrapping="Wrap"
                                                 Foreground="#D6BC84" />
                                    </Grid>
                                  </Grid>
                                </DataTemplate>
                              </ContentControl.ContentTemplate>
                            </ContentControl>

                            <Border Grid.Column="2"
                                    IsVisible="{Binding IsReadOnly}"
                                    Padding="9,5"
                                    CornerRadius="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#1B2329">
                              <TextBlock Text="Read only" FontSize="10" Foreground="#71828D" />
                            </Border>

                            <Expander Grid.Row="1"
                                      Grid.ColumnSpan="3"
                                      IsVisible="{Binding HasPresetValues}"
                                      Margin="0,9,0,0"
                                      Header="Game preset values"
                                      FontSize="11"
                                      Foreground="#91A4AF">
                              <StackPanel Margin="0,8,0,2" Spacing="8">
                                <TextBlock Text="{Binding PresetExplanation}"
                                           TextWrapping="Wrap"
                                           Foreground="#81929D" />
                                <ItemsControl ItemsSource="{Binding PresetValues}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingPresetValueRowViewModel">
                                      <Border Margin="0,0,8,0"
                                              Padding="10,7"
                                              CornerRadius="5"
                                              Background="#172027"
                                              BorderBrush="#29353E"
                                              BorderThickness="1">
                                        <StackPanel Spacing="2">
                                          <TextBlock Text="{Binding Name}"
                                                     FontSize="9"
                                                     Foreground="#71828D" />
                                          <TextBlock Text="{Binding Value}"
                                                     FontWeight="SemiBold"
                                                     Foreground="#C9D4DA" />
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Expander>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding HasNoSearchResults}"
                Padding="18"
                CornerRadius="7"
                Background="#151C22"
                BorderBrush="#273139"
                BorderThickness="1">
          <StackPanel Spacing="3" HorizontalAlignment="Center">
            <TextBlock Text="No matching settings"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#D6DEE3" />
            <TextBlock Text="Try a setting name such as shadow or a renderer key"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       Foreground="#71828D" />
          </StackPanel>
        </Border>

        <Expander IsVisible="{Binding IsAdvancedMode}"
                  Header="Files and diagnostics"
                  IsExpanded="False"
                  FontSize="14"
                  Foreground="#D6DEE3">
          <StackPanel Margin="0,10,0,0" Spacing="10">
            <Border Padding="13" CornerRadius="7" Background="#151C22">
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="Installation" Foreground="#71828D" />
                <TextBlock Grid.Column="1" Text="{Binding InstallationPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="User data" Foreground="#71828D" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserDataPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="System.sav" Foreground="#71828D" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BinarySettingsPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Status" Foreground="#71828D" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BinarySettingsStatus}" TextWrapping="Wrap" Foreground="#C3A66A" />
              </Grid>
            </Border>

            <Expander Header="Configuration files">
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ConfigurationFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigurationFileRowViewModel">
                    <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="#151C22">
                      <Grid ColumnDefinitions="170,*,210">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#8B9AA4" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#8CC8B4" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="Raw INI entries">
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingRowViewModel">
                    <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="#151C22">
                      <Grid ColumnDefinitions="120,2*,2*,60" ColumnSpacing="8">
                        <TextBlock Text="{Binding Source}" Foreground="#71828D" />
                        <TextBlock Grid.Column="1" Text="{Binding Setting}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" Foreground="#8CC8B4" />
                        <TextBlock Grid.Column="3" Text="{Binding Location}" Foreground="#71828D" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="PAK packages">
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding PakFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PakFileRowViewModel">
                    <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="#151C22">
                      <Grid ColumnDefinitions="250,180,*">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#8B9AA4" />
                        <TextBlock Grid.Column="2" Text="{Binding Classification}" Foreground="#C7B98C" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="Inspection notes">
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NoticeRowViewModel">
                    <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="#211D19">
                      <Grid ColumnDefinitions="90,*">
                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="#D6BC84" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Expander>
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowSaveGamesView}" Spacing="12">
          <Border Padding="14,11" CornerRadius="7" Background="#151C22" BorderBrush="#273139" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="Save Games" FontSize="18" FontWeight="SemiBold" Foreground="#EBF0F3" />
                <TextBlock Text="Old saves are kept here. Choose one and load it into the game." FontSize="11" Foreground="#81929D" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Command="{Binding SaveManager.RefreshCommand}" Content="Reload" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Border Padding="14,11" CornerRadius="7" Background="#151C22" BorderBrush="#273139" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding SaveManager.IsWatchdogEnabled, Mode=TwoWay}"
                             OffContent="Off" OnContent="On"
                             VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Enable Auto-Backup (Watchdog)" FontWeight="SemiBold" Foreground="#E6ECEF" />
                <TextBlock Text="Automatically saves a checkpoint in the background whenever the game saves."
                           FontSize="11" Foreground="#82939D" TextWrapping="Wrap" />
                <TextBlock Text="Close the game to load a save file."
                           FontSize="11" Foreground="#82939D" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Auto-Backup interval:" FontSize="11" Foreground="#82939D" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding SaveManager.CooldownChoices}"
                            SelectedItem="{Binding SaveManager.CooldownMinutes, Mode=TwoWay}"
                            Width="76" MinWidth="76" HorizontalAlignment="Left" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel IsVisible="{Binding IsSaveManagerAvailable}" Spacing="12">
          <Border Padding="14,10" CornerRadius="7" Background="#122A23" BorderBrush="#275442" BorderThickness="1"
                  IsVisible="{Binding SaveManager.HasSlots}">
            <TextBlock Text="{Binding SaveManager.StatusMessage}" TextWrapping="Wrap" Foreground="#DDF4EC" />
          </Border>

          <Border Padding="12,10" CornerRadius="7" Background="#211D19" BorderBrush="#3B3120" BorderThickness="1">
            <TextBlock Text="{Binding SaveManager.SteamCloudWarning}" TextWrapping="Wrap" Foreground="#D6BC84" FontSize="11" />
          </Border>

          <ItemsControl ItemsSource="{Binding SaveManager.Slots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveGameSlotViewModel">
                <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="7" Background="#151C22" BorderBrush="#273139" BorderThickness="1">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" Foreground="#E6ECEF" />
                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#82939E" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CheckpointCount}" FontSize="11" Foreground="#78AEE8" />
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding CreateCheckpointCommand}" Content="Save checkpoint" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Checkpoints}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SaveGameCheckpointViewModel">
                          <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="#10171C" BorderBrush="#222C33" BorderThickness="1">
                              <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="10">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding CreatedLabel}" FontWeight="SemiBold" Foreground="#E1E7EA" />
                                <TextBlock Text="{Binding SizeLabel}" FontSize="10" Foreground="#71828D" />
                              </StackPanel>
                                <Button Grid.Column="3" Command="{Binding DeleteCommand}" Content="Delete" Padding="12,6" />

                              <Button Grid.Column="2" Command="{Binding LoadCommand}" Content="Load" Padding="12,6" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No save games found yet. Launch Ancestors once and return here."
                     IsVisible="{Binding SaveManager.HasNoSlots}"
                     Foreground="#82939D" TextWrapping="Wrap" />
          </StackPanel>

          <Border Padding="14,11" CornerRadius="7" Background="#1B2329" BorderBrush="#2B363F" BorderThickness="1"
                  IsVisible="{Binding IsSaveManagerUnavailable}">
            <TextBlock Text="Save Games are only available when an Ancestors user-data folder was found. Install or start Ancestors once, then reload."
                       TextWrapping="Wrap" Foreground="#82939D" />
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowCheatView}" Spacing="12">
          <Border Padding="14,11" CornerRadius="7" Background="#151C22" BorderBrush="#273139" BorderThickness="1">
            <StackPanel Spacing="2">
              <TextBlock Text="God Mode / Cheats" FontSize="18" FontWeight="SemiBold" Foreground="#EBF0F3" />
              <TextBlock Text="Apply cheats to a save slot. Each cheat is stored as a new checkpoint; your original save is never overwritten." FontSize="11" Foreground="#81929D" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Padding="14,11" CornerRadius="7" Background="#2A1F16" BorderBrush="#6B4A26" BorderThickness="1">
            <TextBlock Text="Game must be closed before injecting!" FontWeight="SemiBold" Foreground="#E8C08A" TextWrapping="Wrap" />
          </Border>

          <Border Padding="14,11" CornerRadius="7" Background="#151C22" BorderBrush="#273139" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="Save slot" FontWeight="SemiBold" Foreground="#DDE4E8" />
              <ComboBox ItemsSource="{Binding Cheat.Slots}"
                        SelectedItem="{Binding Cheat.SelectedSlot}"
                        HorizontalAlignment="Left"
                        MinWidth="160" />
            </StackPanel>
          </Border>

          <Border Padding="14,11" CornerRadius="7" Background="#151C22" BorderBrush="#273139" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="Cheats" FontWeight="SemiBold" Foreground="#DDE4E8" />
              <Button Command="{Binding Cheat.MaxNeuronalEnergyCommand}"
                      IsEnabled="{Binding Cheat.CanApply}"
                      Content="Max Neuronal Energy"
                      Padding="14,8" />
              <Button Command="{Binding Cheat.MaxNeedsCommand}"
                      IsEnabled="{Binding Cheat.CanApply}"
                      Content="Max Needs"
                      Padding="14,8" />
              <Button Command="{Binding Cheat.HealClanCommand}"
                      IsEnabled="{Binding Cheat.CanApply}"
                      Content="Heal Clan"
                      Padding="14,8" />
              <Button Command="{Binding Cheat.ForceMutationsCommand}"
                      IsEnabled="{Binding Cheat.CanApply}"
                      Content="Force Mutations"
                      Padding="14,8" />
            </StackPanel>
          </Border>

          <Border Padding="14,11" CornerRadius="7" Background="#1B2329" BorderBrush="#2B363F" BorderThickness="1"
                  IsVisible="{Binding IsCheatUnavailable}">
            <TextBlock Text="Cheats are only available when an Ancestors user-data folder was found. Install or start Ancestors once, then reload."
                       TextWrapping="Wrap" Foreground="#82939D" />
          </Border>

          <Border Padding="14,11" CornerRadius="7" Background="#151C22" BorderBrush="#273139" BorderThickness="1">
            <TextBlock Text="{Binding Cheat.StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{Binding Cheat.StatusAccent}" />
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1"
            ZIndex="10"
            IsVisible="{Binding IsReviewingChanges}"
            Padding="24"
            Background="#E60C1115">
      <Border MaxWidth="900"
              MaxHeight="580"
              Padding="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="9"
              Background="#15232C"
              BorderBrush="#3B7598"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
          <TextBlock Text="{Binding ReviewSummary}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#DCEEFF" />
          <TextBlock Grid.Row="1"
                     Text="Check the old and new values before anything is written"
                     Foreground="#8CA9BA" />
          <ScrollViewer Grid.Row="2" MaxHeight="440">
            <ItemsControl ItemsSource="{Binding ReviewChanges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeReviewRowViewModel">
                  <Border Margin="0,0,0,5" Padding="11" CornerRadius="5" Background="#10191F">
                    <Grid ColumnDefinitions="1.2*,1.2*,Auto,1.2*" ColumnSpacing="10">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TechnicalKey}" FontSize="9" Foreground="#687984" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" Foreground="#8E9DA6" />
                      <TextBlock Grid.Column="2" Text="→" Foreground="#71818C" />
                      <TextBlock Grid.Column="3" Text="{Binding After}" TextWrapping="Wrap" Foreground="#78C7E8" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <Border Grid.Row="2"
              IsVisible="{Binding ShowGraphicsView}"
            Padding="16,10"
            Background="#161D23"
            BorderBrush="#273139"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding PendingSummary}"
                     FontWeight="SemiBold"
                     Foreground="#E1E7EA" />
          <TextBlock Text="{Binding PendingDetails}"
                     IsVisible="{Binding HasPendingChanges}"
                     TextWrapping="Wrap"
                     FontSize="10"
                     Foreground="#C7B98C" />
          <TextBlock Text="{Binding OperationMessage}"
                     TextWrapping="Wrap"
                     FontSize="10"
                     Foreground="{Binding OperationAccent}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Button Command="{Binding RestoreGameDefaultsCommand}"
                  IsEnabled="{Binding CanRestoreGameDefaults}"
                  Content="Restore game defaults" />
          <Button Command="{Binding RevertLastCommand}"
                  IsEnabled="{Binding CanUndo}"
                  Content="Undo" />
          <Button Command="{Binding DiscardChangesCommand}"
                  IsVisible="{Binding ShowPendingActions}"
                  Content="Discard" />
          <Button Command="{Binding OpenReviewCommand}"
                  IsVisible="{Binding ShowPendingActions}"
                  Padding="16,7"
                  Background="#2D715C"
                  Foreground="#F4FFFB"
                  Content="Review" />
          <Button Command="{Binding CancelReviewCommand}"
                  IsVisible="{Binding ShowReviewActions}"
                  Content="Back" />
          <Button Command="{Binding ConfirmApplyCommand}"
                  IsVisible="{Binding ShowReviewActions}"
                  Padding="16,7"
                  Background="#2D715C"
                  Foreground="#F4FFFB"
                  Content="Apply" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
