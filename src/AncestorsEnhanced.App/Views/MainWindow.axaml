<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AncestorsEnhanced.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1120"
        d:DesignHeight="780"
        x:Class="AncestorsEnhanced.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1120"
        Height="780"
        MinWidth="840"
        MinHeight="620"
        Title="Ancestors Enhanced Configurator">

  <Grid RowDefinitions="Auto,*" Background="#0E1216">
    <Border Grid.Row="0" Background="#192028" Padding="28,20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding ProductName}"
                     FontSize="27"
                     FontWeight="SemiBold"
                     Foreground="#F3F6F8" />
          <TextBlock Text="{Binding Phase}"
                     FontSize="14"
                     Foreground="#9FB0BD" />
        </StackPanel>

        <Button Grid.Column="1"
                Command="{Binding RefreshCommand}"
                Padding="18,10"
                VerticalAlignment="Center"
                Content="Check again" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="28" Spacing="18">
        <Border Padding="18"
                CornerRadius="9"
                Background="#17392F"
                BorderBrush="#2B7A63"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding DetectionStatus}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="#E7FFF7" />
              <TextBlock Text="{Binding InstallationDetails}"
                         Foreground="#9ED8C5" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
              <TextBlock Text="{Binding SafetyStatus}"
                         HorizontalAlignment="Right"
                         Foreground="#9ED8C5" />
              <TextBlock Text="{Binding InspectionTime}"
                         HorizontalAlignment="Right"
                         Foreground="#82929E" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Padding="18"
                CornerRadius="9"
                Background="#171D23"
                BorderBrush="#2A343D"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding ViewModeTitle}"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="#F3F6F8" />
              <TextBlock Text="{Binding ViewModeDescription}"
                         FontSize="14"
                         TextWrapping="Wrap"
                         Foreground="#92A3AF" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"
                          Content="Show advanced settings"
                          VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding FeatureGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FeatureGroupRowViewModel">
              <Border Margin="0,0,0,10"
                      CornerRadius="8"
                      Background="#171D23"
                      BorderBrush="#2A343D"
                      BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto">
                  <Button Command="{Binding ToggleExpandedCommand}"
                          Padding="14,10"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0">
                    <Grid ColumnDefinitions="5,*,Auto,34"
                          ColumnSpacing="15"
                          MinHeight="64">
                      <Border Background="{Binding AccentColor}"
                              CornerRadius="3" />
                      <StackPanel Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Spacing="3">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#82929E" />
                        <TextBlock Text="{Binding Name}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#EDF2F5" />
                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#92A3AF" />
                      </StackPanel>
                      <StackPanel Grid.Column="2"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Spacing="4">
                        <TextBlock Text="{Binding Summary}"
                                   HorizontalAlignment="Right"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding AccentColor}" />
                        <TextBlock Text="{Binding SettingCount}"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="#71818C" />
                      </StackPanel>
                      <TextBlock Grid.Column="3"
                                 Text="{Binding Chevron}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="20"
                                 Foreground="#9EADB7" />
                    </Grid>
                  </Button>

                  <ItemsControl Grid.Row="1"
                                Margin="18,4,18,16"
                                IsVisible="{Binding IsExpanded}"
                                ItemsSource="{Binding Settings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FeatureSettingRowViewModel">
                        <Border Padding="13,12"
                                Margin="0,0,0,6"
                                CornerRadius="6"
                                Background="#11171C">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Name}"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         Foreground="#E4EAEE" />
                              <TextBlock Text="{Binding Description}"
                                         TextWrapping="Wrap"
                                         FontSize="12"
                                         LineHeight="18"
                                         Foreground="#9EADB7" />
                              <TextBlock Text="{Binding TechnicalDetails}"
                                         IsVisible="{Binding ShowTechnicalDetails}"
                                         TextWrapping="Wrap"
                                         FontSize="11"
                                         Foreground="#6F808B" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       MinWidth="190"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AccentColor}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Padding="17"
                CornerRadius="8"
                Background="#2B2519"
                BorderBrush="#715D2D"
                BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <TextBlock Text="!"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#D6BC84" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Game-menu graphics"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#F0E4C9" />
              <TextBlock Text="{Binding GameMenuSettingsSummary}"
                         TextWrapping="Wrap"
                         Foreground="#D7C9A9" />
            </StackPanel>
          </Grid>
        </Border>

        <Expander Header="Technical details and raw files"
                  IsExpanded="False"
                  FontSize="16"
                  Foreground="#DCE4E9">
          <StackPanel Margin="0,14,0,0" Spacing="16">
            <Border Padding="18" CornerRadius="8" Background="#171D23">
              <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Installation" Foreground="#92A3AF" />
                <TextBlock Grid.Column="1"
                           Text="{Binding InstallationPath}"
                           TextWrapping="Wrap"
                           Foreground="#E4EAEE" />
                <TextBlock Grid.Row="1" Text="User data" Foreground="#92A3AF" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding UserDataPath}"
                           TextWrapping="Wrap"
                           Foreground="#E4EAEE" />
                <TextBlock Grid.Row="2" Text="System.sav" Foreground="#92A3AF" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding BinarySettingsPath}"
                           TextWrapping="Wrap"
                           Foreground="#E4EAEE" />
                <TextBlock Grid.Row="3" Text="Binary status" Foreground="#92A3AF" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding BinarySettingsStatus}"
                           TextWrapping="Wrap"
                           Foreground="#D6BC84" />
              </Grid>
            </Border>

            <Expander Header="Configuration files">
              <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ConfigurationFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigurationFileRowViewModel">
                    <Border Margin="0,0,0,7" Padding="12" CornerRadius="5" Background="#171D23">
                      <Grid ColumnDefinitions="180,*,220">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#9EADB7" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#9ED8C5" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="Raw INI entries">
              <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingRowViewModel">
                    <Border Margin="0,0,0,6" Padding="11" CornerRadius="5" Background="#151A20">
                      <Grid ColumnDefinitions="140,2*,2*,70">
                        <TextBlock Text="{Binding Source}" Foreground="#8FA1AD" />
                        <TextBlock Grid.Column="1" Text="{Binding Setting}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" Foreground="#A9D7C7" />
                        <TextBlock Grid.Column="3" Text="{Binding Location}" Foreground="#71818C" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="PAK packages">
              <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding PakFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PakFileRowViewModel">
                    <Border Margin="0,0,0,7" Padding="12" CornerRadius="5" Background="#171D23">
                      <Grid ColumnDefinitions="250,200,*">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#9EADB7" />
                        <TextBlock Grid.Column="2" Text="{Binding Classification}" Foreground="#C7B98C" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="Inspection notes">
              <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NoticeRowViewModel">
                    <Border Margin="0,0,0,7" Padding="12" CornerRadius="5" Background="#211D19">
                      <Grid ColumnDefinitions="110,*">
                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="#D6BC84" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
