<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AncestorsEnhanced.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="820"
        x:Class="AncestorsEnhanced.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180"
        Height="820"
        MinWidth="900"
        MinHeight="640"
        Title="Ancestors Enhanced Configurator">

  <Grid RowDefinitions="Auto,*,Auto" Background="#0D1115">
    <Border Grid.Row="0"
            Padding="26,17"
            Background="#171E25"
            BorderBrush="#28333C"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding ProductName}"
                     FontSize="25"
                     FontWeight="SemiBold"
                     Foreground="#F3F6F8" />
          <TextBlock Text="{Binding Phase}"
                     FontSize="13"
                     Foreground="#8FA1AD" />
        </StackPanel>
        <Button Grid.Column="1"
                Command="{Binding RefreshCommand}"
                Padding="16,9"
                VerticalAlignment="Center"
                Content="Reload from disk" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="26,22" Spacing="16">
        <Border Padding="16"
                CornerRadius="8"
                Background="#142B25"
                BorderBrush="#28614F"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding DetectionStatus}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="#DFF7EF" />
              <TextBlock Text="{Binding InstallationDetails}"
                         Foreground="#8FCAB7" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding InspectionTime}"
                       VerticalAlignment="Center"
                       Foreground="#71818C" />
          </Grid>
        </Border>

        <Border Padding="16"
                CornerRadius="8"
                Background="#171D23"
                BorderBrush="#2A343D"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ViewModeTitle}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="#F3F6F8" />
              <TextBlock Text="{Binding ViewModeDescription}"
                         TextWrapping="Wrap"
                         Foreground="#92A3AF" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"
                          Content="Advanced"
                          VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding FeatureGroups}"
                      IsEnabled="{Binding CanEditSettings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FeatureGroupRowViewModel">
              <Border Margin="0,0,0,9"
                      CornerRadius="8"
                      Background="#171D23"
                      BorderBrush="#2A343D"
                      BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto">
                  <Button Command="{Binding ToggleExpandedCommand}"
                          Padding="14,10"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0">
                    <Grid ColumnDefinitions="4,*,Auto,30"
                          ColumnSpacing="14"
                          MinHeight="60">
                      <Border Background="{Binding AccentColor}" CornerRadius="2" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#71818C" />
                        <TextBlock Text="{Binding Name}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#EDF2F5" />
                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#8FA1AD" />
                      </StackPanel>
                      <StackPanel Grid.Column="2"
                                  MinWidth="200"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Spacing="3">
                        <TextBlock Text="{Binding Summary}"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding AccentColor}" />
                        <TextBlock Text="{Binding SettingCount}"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="#667681" />
                      </StackPanel>
                      <TextBlock Grid.Column="3"
                                 Text="{Binding Chevron}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="18"
                                 Foreground="#9EADB7" />
                    </Grid>
                  </Button>

                  <ItemsControl Grid.Row="1"
                                Margin="17,3,17,15"
                                IsVisible="{Binding IsExpanded}"
                                ItemsSource="{Binding Settings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FeatureSettingRowViewModel">
                        <Border Padding="14"
                                Margin="0,0,0,6"
                                CornerRadius="6"
                                Background="#10161B">
                          <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Name}"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         Foreground="#E4EAEE" />
                              <TextBlock Text="{Binding Description}"
                                         TextWrapping="Wrap"
                                         FontSize="12"
                                         LineHeight="18"
                                         Foreground="#92A3AF" />
                              <TextBlock Text="{Binding TechnicalDetails}"
                                         IsVisible="{Binding ShowTechnicalDetails}"
                                         Margin="0,3,0,0"
                                         TextWrapping="Wrap"
                                         FontSize="11"
                                         Foreground="#647680" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="9">
                              <StackPanel Spacing="2">
                                <TextBlock Text="CURRENT"
                                           HorizontalAlignment="Right"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#667681" />
                                <TextBlock Text="{Binding Value}"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentColor}" />
                              </StackPanel>

                              <ContentControl Content="{Binding Editor}"
                                              IsVisible="{Binding IsEditable}">
                                <ContentControl.ContentTemplate>
                                  <DataTemplate x:DataType="vm:SettingEditorViewModel">
                                    <Border Padding="10"
                                            CornerRadius="5"
                                            Background="#182128"
                                            BorderBrush="#2D3A44"
                                            BorderThickness="1">
                                      <StackPanel Spacing="8">
                                        <ToggleSwitch IsVisible="{Binding IsPresence}"
                                                      IsChecked="{Binding UseCustomValue, Mode=TwoWay}"
                                                      Content="Skip startup videos" />

                                        <StackPanel IsVisible="{Binding IsRegularEditor}" Spacing="8">
                                          <ToggleSwitch IsChecked="{Binding UseCustomValue, Mode=TwoWay}"
                                                        Content="{Binding OverrideLabel}" />

                                          <Grid IsEnabled="{Binding UseCustomValue}">
                                            <ToggleSwitch IsVisible="{Binding IsToggle}"
                                                          IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                                                          HorizontalAlignment="Right"
                                                          Content="Enabled" />

                                            <Grid IsVisible="{Binding IsNumber}"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                              <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay}"
                                                             Minimum="{Binding Minimum}"
                                                             Maximum="{Binding Maximum}"
                                                             Increment="{Binding Increment}"
                                                             FormatString="0.####"
                                                             HorizontalAlignment="Stretch" />
                                              <TextBlock Grid.Column="1"
                                                         Text="{Binding Unit}"
                                                         IsVisible="{Binding HasUnit}"
                                                         VerticalAlignment="Center"
                                                         Foreground="#92A3AF" />
                                            </Grid>

                                            <ComboBox IsVisible="{Binding IsChoice}"
                                                      ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch">
                                              <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingChoiceViewModel">
                                                  <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                              </ComboBox.ItemTemplate>
                                            </ComboBox>
                                          </Grid>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ModeLabel}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#71818C" />
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ContentControl.ContentTemplate>
                              </ContentControl>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Header="Technical details"
                  IsExpanded="False"
                  FontSize="15"
                  Foreground="#DCE4E9">
          <StackPanel Margin="0,12,0,0" Spacing="14">
            <Border Padding="16" CornerRadius="8" Background="#171D23">
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                <TextBlock Text="Installation" Foreground="#82929E" />
                <TextBlock Grid.Column="1" Text="{Binding InstallationPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="User data" Foreground="#82929E" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserDataPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="System.sav" Foreground="#82929E" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BinarySettingsPath}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Binary status" Foreground="#82929E" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BinarySettingsStatus}" TextWrapping="Wrap" Foreground="#C3A66A" />
              </Grid>
            </Border>

            <Expander Header="Configuration files">
              <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding ConfigurationFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigurationFileRowViewModel">
                    <Border Margin="0,0,0,6" Padding="11" CornerRadius="5" Background="#171D23">
                      <Grid ColumnDefinitions="180,*,220">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#9EADB7" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#9ED8C5" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="Raw INI entries">
              <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingRowViewModel">
                    <Border Margin="0,0,0,5" Padding="10" CornerRadius="5" Background="#151A20">
                      <Grid ColumnDefinitions="130,2*,2*,65">
                        <TextBlock Text="{Binding Source}" Foreground="#8FA1AD" />
                        <TextBlock Grid.Column="1" Text="{Binding Setting}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" Foreground="#A9D7C7" />
                        <TextBlock Grid.Column="3" Text="{Binding Location}" Foreground="#71818C" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="PAK packages">
              <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding PakFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PakFileRowViewModel">
                    <Border Margin="0,0,0,6" Padding="11" CornerRadius="5" Background="#171D23">
                      <Grid ColumnDefinitions="250,190,*">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="#9EADB7" />
                        <TextBlock Grid.Column="2" Text="{Binding Classification}" Foreground="#C7B98C" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander Header="Inspection notes">
              <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NoticeRowViewModel">
                    <Border Margin="0,0,0,6" Padding="11" CornerRadius="5" Background="#211D19">
                      <Grid ColumnDefinitions="100,*">
                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="#D6BC84" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1"
            ZIndex="10"
            IsVisible="{Binding IsReviewingChanges}"
            Padding="26"
            Background="#D90D1115">
      <Border MaxWidth="980"
              MaxHeight="620"
              Padding="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="9"
              Background="#15232C"
              BorderBrush="#3B7598"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <TextBlock Text="{Binding ReviewSummary}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#DCEEFF" />
          <TextBlock Grid.Row="1"
                     Text="Nothing has been written yet. Check the old and new values below."
                     TextWrapping="Wrap"
                     Foreground="#92AFC1" />
          <ScrollViewer Grid.Row="2" MaxHeight="470">
            <ItemsControl ItemsSource="{Binding ReviewChanges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeReviewRowViewModel">
                  <Border Margin="0,0,0,6" Padding="12" CornerRadius="5" Background="#111A20">
                    <Grid ColumnDefinitions="1.2*,1.2*,Auto,1.2*" ColumnSpacing="12">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TechnicalKey}" FontSize="10" Foreground="#71818C" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" Foreground="#9EADB7" />
                      <TextBlock Grid.Column="2" Text="→" Foreground="#71818C" />
                      <TextBlock Grid.Column="3" Text="{Binding After}" TextWrapping="Wrap" Foreground="#78C7E8" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <Border Grid.Row="2"
            Padding="18,12"
            Background="#171E25"
            BorderBrush="#2A343D"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding PendingSummary}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="#E4EAEE" />
          <TextBlock Text="{Binding PendingDetails}"
                     IsVisible="{Binding HasPendingChanges}"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="#C7B98C" />
          <TextBlock Text="{Binding OperationMessage}"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{Binding OperationAccent}" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="9">
          <Button Command="{Binding RevertLastCommand}"
                  IsEnabled="{Binding CanUndo}"
                  Content="Undo last apply" />
          <Button Command="{Binding DiscardChangesCommand}"
                  IsVisible="{Binding ShowPendingActions}"
                  Content="Discard" />
          <Button Command="{Binding OpenReviewCommand}"
                  IsVisible="{Binding ShowPendingActions}"
                  Padding="18,8"
                  Background="#2D715C"
                  Foreground="#F4FFFB"
                  Content="Review changes" />
          <Button Command="{Binding CancelReviewCommand}"
                  IsVisible="{Binding ShowReviewActions}"
                  Content="Back" />
          <Button Command="{Binding ConfirmApplyCommand}"
                  IsVisible="{Binding ShowReviewActions}"
                  Padding="18,8"
                  Background="#2D715C"
                  Foreground="#F4FFFB"
                  Content="Confirm apply" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
