<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AncestorsEnhanced.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="820"
        x:Class="AncestorsEnhanced.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        MinWidth="780"
        MinHeight="600"
        Icon="/Assets/aec-icon.ico"
        Title="Ancestors Enhanced Configurator">

  <Grid ColumnDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
    <ProgressBar Grid.ColumnSpan="2" ZIndex="1000"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Stretch"
                 Height="3"
                 Foreground="{DynamicResource OrangeAccentBrush}"
                 Background="Transparent"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsAnyOperationRunning}" />
    <!-- Sidebar navigation -->
    <Border Grid.Column="0"
            x:Name="NavigationPane"
            Width="200"
            Padding="20,22,18,22"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="5">
        <StackPanel Spacing="1" Margin="0,0,0,18">
          <TextBlock Text="{Binding ProductName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
          <TextBlock Text="Configurator" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ToggleButton Classes="nav"
                      Command="{Binding ShowHomeCommand}"
                      IsChecked="{Binding ShowHomeView, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Content="Home" />
        <ToggleButton Classes="nav"
                      Command="{Binding ShowGraphicsCommand}"
                      IsChecked="{Binding IsGraphicsSectionActive, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                       Content="Graphics" />
        <ToggleButton Classes="nav"
                      Command="{Binding ShowSaveGamesCommand}"
                      IsChecked="{Binding ShowSaveGamesView, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                       Content="Saves" />
        <ToggleButton Classes="nav"
                      Command="{Binding ShowGameplayCommand}"
                      IsChecked="{Binding ShowGameplayView, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Content="Gameplay" />
        <ToggleButton Classes="nav"
                      Command="{Binding ShowProfilesCommand}"
                      IsChecked="{Binding ShowProfilesView, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Content="Profiles" />
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="5">
        <ToggleButton Classes="nav"
                      Command="{Binding ShowSettingsCommand}"
                      IsChecked="{Binding IsSettingsSectionActive, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Content="Settings" />
        <ToggleButton Classes="nav"
                      Command="{Binding ShowDiagnosticsCommand}"
                      IsChecked="{Binding ShowDiagnosticsView, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Content="Diagnostics" />
      </StackPanel>
      </Grid>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Grid.Column="1"
            Padding="30,18"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding PageContextLabel}"
                     x:Name="PageContextTitle"
                     FontSize="23"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1"
                x:Name="ReloadGameDataButton"
                Content="Reload game data"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsAnyOperationRunning}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="30,26,30,72"
                  Spacing="16"
                  MaxWidth="1500"
                  HorizontalAlignment="Stretch">

        <StackPanel IsVisible="{Binding ShowHomeView}" Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding HomeTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="{Binding InstallationDetails}" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,8" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding DetectionBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="9" Height="9" Fill="{Binding DetectionBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DetectionStatus}" Foreground="{Binding DetectionBrush}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Padding="18" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="5">
                <TextBlock Text="SUGGESTED STARTING POINT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelTextBrush}" />
                <TextBlock Text="{Binding HardwareDiagnostics.Recommendation.PresetName}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
                <TextBlock Text="{Binding HardwareDiagnostics.Recommendation.Description}" MaxWidth="650" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding HardwareScanMessage}" IsVisible="{Binding HasHardwareScanMessage}" MaxWidth="650" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource GoldTextBrush}" />
                <TextBlock Text="CPU, memory, graphics adapter and dedicated VRAM are read locally from your system. AEC uses them only for a conservative recommendation, never as a benchmark." IsVisible="{Binding !HardwareDiagnostics.Recommendation.CanStagePreset}" MaxWidth="650" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TechnicalTextBrush}" />
                <Expander Header="Detected hardware" FontSize="11" Foreground="{DynamicResource TechnicalTextBrush}">
                  <StackPanel Spacing="2" Margin="0,5,0,0">
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="CPU: " /><Run Text="{Binding HardwareDiagnostics.Cpu}" /></TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="Memory: " /><Run Text="{Binding HardwareDiagnostics.Memory}" /></TextBlock>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="Graphics: " /><Run Text="{Binding HardwareDiagnostics.Graphics}" /></TextBlock>
                  </StackPanel>
                </Expander>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <Button Classes="PrimaryAction" Content="Review recommendation" Command="{Binding LoadHardwareRecommendationCommand}" IsVisible="{Binding HardwareDiagnostics.Recommendation.CanStagePreset}" />
                <Button Content="{Binding DetailedHardwareActionLabel}" Command="{Binding RunDetailedHardwareDetectionCommand}" IsVisible="{Binding CanShowHardwareScanAction}" IsEnabled="{Binding CanRunDetailedHardwareDetection}" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <Border Padding="16" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="5"><TextBlock Text="GRAPHICS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelTextBrush}" /><TextBlock Text="{Binding HomeGraphicsSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><Button Content="Change graphics" Command="{Binding ShowGraphicsCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="5">
                <TextBlock Text="GAMEPLAY DIFFICULTY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelTextBrush}" />
                <TextBlock Text="{Binding HomeGameplayTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding HomeGameplaySummary}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding ExternalPakHelpText}" IsVisible="{Binding HasExternalPaks}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource GoldTextBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Adjust difficulty" Command="{Binding ShowGameplayCommand}" />
                  <Button Content="Open game PAK folder" Command="{Binding OpenGamePakFolderCommand}" IsVisible="{Binding CanOpenGamePakFolder}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="16" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="5"><TextBlock Text="SAVES &amp; BACKUPS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelTextBrush}" /><TextBlock Text="{Binding HomeSavesSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><Button Content="Manage saves" Command="{Binding ShowSaveGamesCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="3" Padding="14,11" CornerRadius="9" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" IsVisible="{Binding HasPendingChanges}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><StackPanel Spacing="2"><TextBlock Text="CURRENT CHANGES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelTextBrush}" /><TextBlock Text="{Binding PendingSummary}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding PendingDetails}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel><Button Grid.Column="1" Content="Review changes" Command="{Binding OpenReviewCommand}" VerticalAlignment="Center" /></Grid>
            </Border>
          </Grid>
        </StackPanel>


        <StackPanel IsVisible="{Binding ShowGraphicsView}" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <Border Padding="14,10"
                  CornerRadius="7"
                  BorderThickness="1"
                  BorderBrush="{Binding DetectionBrush}"
                  Background="{DynamicResource SurfaceBrush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Ellipse Width="9" Height="9" Fill="{Binding DetectionBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding DetectionStatus}"
                           FontWeight="SemiBold"
                           Foreground="{Binding DetectionBrush}" />
                <TextBlock Text="{Binding InstallationDetails}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  Padding="4"
                  CornerRadius="7"
                  Background="{DynamicResource RaisedSurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton Classes="mode"
                            Command="{Binding ShowSimpleCommand}"
                            IsChecked="{Binding IsSimpleMode, Mode=OneWay}"
                            Content="Simple" />
              <ToggleButton Classes="mode"
                            Command="{Binding ShowAdvancedCommand}"
                            IsChecked="{Binding IsAdvancedMode, Mode=OneWay}"
                            Content="Advanced" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="SettingCard" Padding="14,11">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding ViewModeTitle}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource HeadingTextBrush}" />
              <TextBlock Text="{Binding ViewModeDescription}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <Grid IsVisible="{Binding IsAdvancedMode}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                       PlaceholderText="Search settings…"
                       VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <ToggleButton Classes="mode" Command="{Binding ShowAllGraphicsCommand}" IsChecked="{Binding IsAllGraphicsFilter}" Content="All" />
                <ToggleButton Classes="mode" Command="{Binding ShowModifiedGraphicsCommand}" IsChecked="{Binding IsModifiedGraphicsFilter}" Content="Modified" />
                <ToggleButton Classes="mode" Command="{Binding ShowGameDefaultsGraphicsCommand}" IsChecked="{Binding IsGameDefaultsGraphicsFilter}" Content="Game defaults" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OliveBorderBrush}" BorderThickness="1"
                IsVisible="{Binding HasGamePreset}">
          <StackPanel Spacing="3">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}">
              <Run Text="Game preset: " /><Run Text="{Binding GamePresetName}" Foreground="{DynamicResource AccentBrush}" />
              <Run Text=" · Custom overrides: " /><Run Text="{Binding CustomOverrideCount}" Foreground="{DynamicResource OrangeAccentBrush}" />
            </TextBlock>
            <TextBlock Text="Custom settings replace parts of the selected game preset. Settings that still come from the preset show their Low/Medium/High value; overridden settings show their custom value." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Save as profile" Command="{Binding CreateProfileFromGraphicsCommand}" />
          <Button Content="Manage profiles" Command="{Binding ShowProfilesCommand}" />
        </StackPanel>

        <Border Classes="SettingCard InteractiveCard" Padding="16,14">
          <StackPanel Spacing="10">
            <Button Classes="CardHeader" Command="{Binding ToggleGraphicsPresetsCommand}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsHitTestVisible="False">
                <StackPanel Spacing="2">
                  <TextBlock Text="Choose a graphics setup" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="First choose one performance baseline. Optional image styles can be added afterwards without replacing that baseline." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding GraphicsPresetsToggleLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel IsVisible="{Binding IsGraphicsPresetsExpanded}" Spacing="14">
              <StackPanel Spacing="2">
                <TextBlock Text="Performance baseline" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                <TextBlock Text="Pick one. These configure the game-quality baseline, texture streaming and anti-aliasing together." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding HardwareGraphicsPresets}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="220" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuiltInGraphicsPresetViewModel">
                    <Border Classes="PresetCard" Padding="14,11" Margin="0,0,10,8" MinHeight="128" Width="210">
                      <Grid RowDefinitions="*,Auto" RowSpacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                          <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7">
                          <Button Content="Preview changes" Command="{Binding $parent[Window].DataContext.PreviewBuiltInGraphicsPresetCommand}" CommandParameter="{Binding}" />
                          <Button Content="{Binding ActionLabel}" Command="{Binding $parent[Window].DataContext.LoadBuiltInGraphicsPresetCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="2">
                <TextBlock Text="Optional image style" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                <TextBlock Text="These only adjust the look. They can be combined with one performance baseline." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ImageStyleGraphicsPresets}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="220" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuiltInGraphicsPresetViewModel">
                    <Border Classes="PresetCard" Padding="14,11" Margin="0,0,10,0" MinHeight="116" Width="210">
                      <Grid RowDefinitions="*,Auto" RowSpacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                          <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7">
                          <Button Content="Preview changes" Command="{Binding $parent[Window].DataContext.PreviewBuiltInGraphicsPresetCommand}" CommandParameter="{Binding}" />
                          <Button Content="{Binding ActionLabel}" Command="{Binding $parent[Window].DataContext.LoadBuiltInGraphicsPresetCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border IsVisible="{Binding HasGraphicsPresetPreview}" Padding="12,10" CornerRadius="7" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource OliveBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding GraphicsPresetPreviewTitle}" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                    <TextBlock Text="{Binding GraphicsPresetPreviewSummary}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding GraphicsPresetPreviewValues}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="190" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GraphicsPresetPreviewValueViewModel">
                        <Border Padding="8,6" Margin="0,0,7,5" Width="180" CornerRadius="5" Background="{DynamicResource EditorSurfaceBrush}" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="1">
                          <StackPanel Spacing="1"><TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TechnicalTextBrush}" /><TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" /></StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding FeatureGroups}"
                      IsEnabled="{Binding CanEditSettings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FeatureGroupRowViewModel">
              <Border Margin="0,0,0,8"
                      Classes="SettingCard">
                <Grid RowDefinitions="Auto,Auto">
                  <Button Classes="CardHeader"
                          Command="{Binding ToggleExpandedCommand}"
                          AutomationProperties.Name="{Binding Name}"
                          Padding="14,10"
                          MinHeight="42"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0">
                    <Grid ColumnDefinitions="4,*,Auto,22" ColumnSpacing="12" IsHitTestVisible="False">
                      <Border Background="{Binding AccentBrush}" CornerRadius="2" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelTextBrush}" />
                          <Border IsVisible="{Binding HasChangedSettings}" Padding="6,1" CornerRadius="7" Background="{DynamicResource ControlHoverBrush}" BorderBrush="{DynamicResource OliveBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding ChangeBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                        <TextBlock Text="{Binding Description}" IsVisible="{Binding ShowDescription}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource LabelTextBrush}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                        <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="280" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding SettingCount}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource LabelTextBrush}" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding Chevron}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MidTextBrush}" />
                    </Grid>
                  </Button>

                  <Border Grid.Row="1"
                          CornerRadius="0,0,9,9"
                          ClipToBounds="True"
                          IsVisible="{Binding IsExpanded}">
                    <StackPanel>
                    <Button Content="Reset custom overrides in this group"
                            Command="{Binding $parent[Window].DataContext.ResetGraphicsGroupCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding HasResettableChanges}"
                            HorizontalAlignment="Right"
                            Margin="14,8,14,4" />
                    <ItemsControl ItemsSource="{Binding Settings}">
                      <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FeatureSettingRowViewModel">
                        <Border Padding="14,16"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBackgroundBrush}"
                                BorderThickness="0,1,0,0"
                                ToolTip.Tip="{Binding Description}">
                          <Grid RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="18"
                                MinHeight="46">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Name}"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource BodyTextBrush}" />
                              <TextBlock Text="{Binding Description}"
                                         IsVisible="{Binding ShowDescription}"
                                         TextWrapping="Wrap"
                                         FontSize="12"
                                         Foreground="{DynamicResource LabelTextBrush}" />
                              <TextBlock Text="{Binding TechnicalKey}"
                                         IsVisible="{Binding ShowTechnicalDetails}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TechnicalTextBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Spacing="1">
                              <TextBlock Text="{Binding ValueLabel}"
                                         HorizontalAlignment="Right"
                                         FontSize="11"
                                         Foreground="{DynamicResource TechnicalTextBrush}" />
                              <TextBlock IsVisible="{Binding Editor.HasChanges}"
                                         HorizontalAlignment="Right"
                                         TextAlignment="Right"
                                         TextWrapping="Wrap"
                                         MaxWidth="180"
                                         FontSize="11"
                                         Foreground="{DynamicResource GoldTextBrush}">
                                <Run Text="{Binding Value}" /><Run Text=" → " /><Run Text="{Binding Editor.DesiredSummary}" />
                              </TextBlock>
                              <TextBlock Text="Experimental"
                                         IsVisible="{Binding IsExperimental}"
                                         HorizontalAlignment="Right"
                                         FontSize="10"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource GoldTextBrush}" />
                              <TextBlock Text="{Binding Value}"
                                         IsVisible="{Binding !Editor.HasChanges}"
                                         HorizontalAlignment="Right"
                                         TextAlignment="Right"
                                         TextWrapping="Wrap"
                                         MaxWidth="140"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>

                            <ContentControl Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Content="{Binding Editor}"
                                            IsVisible="{Binding IsEditable}"
                                            HorizontalAlignment="Stretch"
                                            MaxWidth="520"
                                            Margin="0,12,0,0"
                                            VerticalAlignment="Center">
                              <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:SettingEditorViewModel">
                                  <Grid>
                                    <ToggleSwitch IsVisible="{Binding IsPresence}"
                                                  IsChecked="{Binding UseCustomValue, Mode=TwoWay}"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Skip startup videos"
                                                  Content="Skip startup videos" />

                                    <Grid IsVisible="{Binding IsRegularEditor}">
                                      <Grid IsEnabled="{Binding IsCustomEditorEnabled}"
                                            IsVisible="{Binding ShowValueEditor}">
                                        <ToggleSwitch IsVisible="{Binding IsToggle}"
                                                      IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                                                      AutomationProperties.Name="Value"
                                                      HorizontalAlignment="Right" />

                                        <Grid IsVisible="{Binding IsNumber}"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="7">
                                          <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay}"
                                                         Minimum="{Binding Minimum}"
                                                         Maximum="{Binding Maximum}"
                                                         Increment="{Binding Increment}"
                                                         FormatString="0.####"
                                                         AutomationProperties.Name="Value"
                                                         HorizontalAlignment="Stretch" />
                                          <TextBlock Grid.Column="1"
                                                     Text="{Binding Unit}"
                                                     IsVisible="{Binding HasUnit}"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource LabelTextBrush}" />
                                        </Grid>

                                        <ComboBox IsVisible="{Binding IsChoice}"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                          <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingChoiceViewModel">
                                              <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                          </ComboBox.ItemTemplate>
                                        </ComboBox>
                                      </Grid>

                                      <TextBlock IsVisible="{Binding HasUnsupportedCurrentValue}"
                                                 Text="Unsupported value detected."
                                                 TextWrapping="Wrap"
                                                 Foreground="{DynamicResource GoldTextBrush}" />
                                    </Grid>
                                  </Grid>
                                </DataTemplate>
                              </ContentControl.ContentTemplate>
                            </ContentControl>

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    IsVisible="{Binding IsReadOnly}"
                                    Padding="9,5"
                                    Margin="0,12,0,0"
                                    CornerRadius="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceBrush}">
                              <TextBlock Text="{Binding ReadOnlyLabel}" FontSize="12" Foreground="{DynamicResource TechnicalTextBrush}" TextWrapping="Wrap" />
                            </Border>

                            <Expander Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      IsVisible="{Binding HasPresetValues}"
                                      Margin="0,9,0,0"
                                      Header="Game preset values"
                                      FontSize="12"
                                      Foreground="{DynamicResource MidTextBrush}">
                              <StackPanel Margin="0,8,0,2" Spacing="8">
                                <TextBlock Text="{Binding PresetExplanation}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource LabelTextBrush}" />
                                <ItemsControl ItemsSource="{Binding PresetValues}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingPresetValueRowViewModel">
                                      <Border Margin="0,0,8,0"
                                              Padding="10,7"
                                              CornerRadius="5"
                                              Background="{DynamicResource EditorSurfaceBrush}"
                                              BorderBrush="{DynamicResource EditorBorderBrush}"
                                              BorderThickness="1">
                                        <StackPanel Spacing="2">
                                          <TextBlock Text="{Binding Name}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TechnicalTextBrush}" />
                                          <TextBlock Text="{Binding Value}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource BodyTextBrush}" />
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Expander>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding HasNoSearchResults}"
                Padding="18"
                CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
          <StackPanel Spacing="3" HorizontalAlignment="Center">
            <TextBlock Text="No matching settings"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BodyTextBrush}" />
            <TextBlock Text="Try a setting name such as shadow or a renderer key"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TechnicalTextBrush}" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsAdvancedMode}" Padding="12,10" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Need technical information? Open Diagnostics for files, PAKs and inspection notes." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Open diagnostics" Command="{Binding ShowDiagnosticsCommand}" />
          </Grid>
        </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowSaveGamesView}" Spacing="16">
          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="Save Games" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
                <TextBlock Text="Five slots · checkpoints · restore" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Padding="14,11"
                  CornerRadius="7"
                  Background="{DynamicResource WarningSurfaceBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding SaveManager.HasToolSettingsWarning}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <TextBlock Text="{Binding SaveManager.ToolSettingsWarning}"
                         Foreground="{DynamicResource GoldTextBrush}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="Reset auto-backup settings"
                      Command="{Binding SaveManager.ResetToolSettingsCommand}"
                      IsEnabled="{Binding SaveManager.CanResetToolSettings}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Border Classes="SettingCard" Padding="12,9" CornerRadius="7" BorderThickness="1"
                    IsVisible="{Binding IsSaveManagerAvailable}"
                    IsEnabled="{Binding SaveManager.CanConfigureAutoBackup}">
            <Grid ColumnDefinitions="Auto,*,Auto,132,Auto" ColumnSpacing="12">
              <ToggleSwitch IsChecked="{Binding SaveManager.IsWatchdogEnabled, Mode=TwoWay}"
                             OffContent="Off" OnContent="On"
                             AutomationProperties.Name="Enable Auto-Backup"
                             VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Enable Auto-Backup" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                <TextBlock Text="Creates a checkpoint when the game saves."
                           FontSize="12" Foreground="{DynamicResource LabelTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="Minimum interval" FontSize="12" Foreground="{DynamicResource LabelTextBrush}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="3" Value="{Binding SaveManager.CooldownMinutes, Mode=TwoWay}"
                             Minimum="1" Maximum="1440" Increment="1"
                             IsEnabled="{Binding SaveManager.IsWatchdogEnabled}"
                             Width="132" MinWidth="132" HorizontalAlignment="Left"
                             ToolTip.Tip="Any whole number from 1 to 1440 minutes." />
              <TextBlock Grid.Column="4" Text="min" FontSize="12" Foreground="{DynamicResource LabelTextBrush}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <StackPanel IsVisible="{Binding IsSaveManagerAvailable}" Spacing="12">
          <Border Padding="12,9" CornerRadius="7" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource GoldTextBrush}" BorderThickness="1"
                  IsVisible="{Binding SaveManager.IsGameRunning}">
            <TextBlock Text="Ancestors is running. Checkpoints can be created, but restoring is disabled until the game closes."
                       Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
          </Border>
          <Border Padding="14,10" CornerRadius="7" BorderThickness="1"
                  BorderBrush="{Binding SaveManager.StatusBrush}"
                  Background="{DynamicResource SurfaceBrush}"
                  IsVisible="True">
            <TextBlock Text="{Binding SaveManager.StatusMessage}" TextWrapping="Wrap" Foreground="{Binding SaveManager.StatusBrush}" />
          </Border>

          <Expander Header="{Binding SaveManager.CloudWarningTitle}" Padding="12,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CloudWarningBorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding SaveManager.CloudWarning}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource GoldTextBrush}" FontSize="12" />
          </Expander>

          <Border Padding="12,10" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,180" ColumnSpacing="10">
              <TextBox PlaceholderText="Search checkpoint name, note or origin"
                       Text="{Binding SaveManager.CheckpointSearchText}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SaveManager.CheckpointOriginFilters}"
                        SelectedItem="{Binding SaveManager.CheckpointOriginFilter, Mode=TwoWay}" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding SaveManager.Slots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveGameSlotViewModel">
                <Border Margin="0,0,0,8" Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TechnicalTextBrush}" />
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource LabelTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CheckpointCount}" FontSize="12" Foreground="{DynamicResource LabelTextBrush}" />
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding CreateCheckpointCommand}" IsEnabled="{Binding CanSaveCheckpoint}" Content="Save checkpoint" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding VisibleCheckpoints}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SaveGameCheckpointViewModel">
                          <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                                <TextBlock Text="{Binding CreatedLabel}" FontSize="12" Foreground="{DynamicResource LabelTextBrush}" />
                                <TextBlock Text="{Binding OriginLabel}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding SizeLabel}" FontSize="12" Foreground="{DynamicResource TechnicalTextBrush}" />
                                <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12" Foreground="{DynamicResource GoldTextBrush}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <ToggleButton Content="★" ToolTip.Tip="Favorite" IsChecked="{Binding IsFavorite, Mode=TwoWay}" />
                                <Button Command="{Binding OpenRestoreConfirmCommand}" IsEnabled="{Binding CanRestore}" Content="Restore" Padding="12,6" IsVisible="{Binding !IsRestoreConfirmVisible}" />
                                <Button IsVisible="{Binding IsRestoreConfirmVisible}" IsEnabled="{Binding CanRestore}" Classes="PrimaryAction" Content="Confirm restore" Padding="12,6" Command="{Binding LoadCommand}" />
                                <Button IsVisible="{Binding IsRestoreConfirmVisible}" Classes="Ghost" Content="Cancel" Padding="12,6" Command="{Binding CancelRestoreConfirmCommand}" />
                                <Expander Header="More" FontSize="12">
                                  <StackPanel Spacing="5" Margin="0,6,0,0">
                                    <Button Content="Edit name / note" Command="{Binding ToggleMetadataEditorCommand}" />
                                    <Button Classes="Ghost" Content="Delete" Foreground="{DynamicResource GoldTextBrush}" Command="{Binding OpenDeleteConfirmCommand}" IsEnabled="{Binding CanDelete}" IsVisible="{Binding !IsDeleteConfirmVisible}" />
                                    <Button IsVisible="{Binding IsDeleteConfirmVisible}" Classes="DangerAction" Content="Yes, delete it" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
                                    <Button IsVisible="{Binding IsDeleteConfirmVisible}" Classes="Ghost" Content="Cancel" Command="{Binding CancelDeleteConfirmCommand}" />
                                  </StackPanel>
                                </Expander>
                              </StackPanel>
                            </Grid>
                            <StackPanel IsVisible="{Binding IsMetadataEditorVisible}" Spacing="6" Margin="0,8,0,0">
                              <TextBox PlaceholderText="Checkpoint name optional" Text="{Binding Title}" MaxLength="80" />
                              <TextBox PlaceholderText="Note optional" Text="{Binding Note}" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />
                            </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding ShowAllLabel}"
                            Command="{Binding ShowOlderCommand}"
                            IsVisible="{Binding HasHiddenCheckpoints}"
                            HorizontalAlignment="Left" Padding="8,4" Margin="-8,-4" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OrangeAccentBrush}" FontSize="12" />
                    <Button Content="Show less"
                            Command="{Binding ShowRecentCommand}"
                            IsVisible="{Binding HasExpandedCheckpoints}"
                            HorizontalAlignment="Left" Padding="8,4" Margin="-8,-4" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OrangeAccentBrush}" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Padding="12,10" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding SaveManager.BackupHealthBrush}" BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Text="Backup health" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
              <TextBlock Text="{Binding SaveManager.BackupHealthSummary}" TextWrapping="Wrap" Foreground="{Binding SaveManager.BackupHealthBrush}" />
              <TextBlock Text="This is an inventory-level scan of checkpoint paths, manifests and sizes. Full decompression and hash validation happen immediately before a restore; AEC never treats this list as proof that a checkpoint loaded successfully in-game."
                         FontSize="12" Foreground="{DynamicResource GoldTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel IsVisible="{Binding SaveManager.HasNoSlots}" Spacing="10" Margin="0,2,0,0">
            <Border Classes="SettingCard" Padding="16,14" CornerRadius="7" BorderThickness="1">
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="No save games found yet"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Start Ancestors once and create a save; then it appears here along with any checkpoints."
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource LabelTextBrush}" />
                <Button Classes="PrimaryAction"
                        Content="Scan for save games"
                        Command="{Binding SaveManager.RefreshCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
          </StackPanel>

          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  IsVisible="{Binding IsSaveManagerUnavailable}">
            <StackPanel Spacing="8">
              <TextBlock Text="Save management requires a supported, verified Ancestors installation and detected user data. If the game is running or recovery is pending, close it and reload."
                         TextWrapping="Wrap" Foreground="{DynamicResource LabelTextBrush}" />
              <Button Classes="PrimaryAction" Content="Scan again" Command="{Binding RefreshCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowGameplayView}" Spacing="16">
          <Border Classes="SettingCard" Padding="14,11">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="Gameplay difficulty" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
              <TextBlock Text="Verified build-bound PAK · no save changes" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="4" CornerRadius="7" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton Classes="mode" Command="{Binding ShowGameplaySimpleCommand}" IsChecked="{Binding IsGameplaySimpleMode, Mode=OneWay}" Content="Simple" />
                <ToggleButton Classes="mode" Command="{Binding ShowGameplayAdvancedCommand}" IsChecked="{Binding IsGameplayAdvancedMode, Mode=OneWay}" Content="Advanced" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>

          <Border Classes="SettingCard" Padding="14,11">
            <StackPanel Spacing="2">
              <TextBlock Text="Simple" IsVisible="{Binding IsGameplaySimpleMode}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
              <TextBlock Text="Start with a preset, then adjust the six core survival and hazard controls." IsVisible="{Binding IsGameplaySimpleMode}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="Advanced" IsVisible="{Binding IsGameplayAdvancedMode}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
              <TextBlock Text="All core controls stay available here. Use the additional recovery, wound and exhaustion controls only when you need them." IsVisible="{Binding IsGameplayAdvancedMode}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
          </Border>

          <Border Padding="4" CornerRadius="7" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsVisible="{Binding IsGameplayAdvancedMode}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton Classes="mode" Command="{Binding ShowGameplaySurvivalTabCommand}" IsChecked="{Binding IsGameplaySurvivalTab, Mode=OneWay}" Content="Survival" />
              <ToggleButton Classes="mode" Command="{Binding ShowGameplayRecoveryTabCommand}" IsChecked="{Binding IsGameplayRecoveryTab, Mode=OneWay}" Content="Health &amp; recovery" />
              <ToggleButton Classes="mode" Command="{Binding ShowGameplayResearchTabCommand}" IsChecked="{Binding IsGameplayResearchTab, Mode=OneWay}" Content="Research" />
            </StackPanel>
          </Border>

          <StackPanel IsVisible="{Binding IsGameplaySimpleMode}">
            <Border Classes="SettingCard InteractiveCard" Padding="14,11" IsVisible="{Binding HasGameplayDifficultyPresets}">
              <StackPanel Spacing="10">
                <Button Classes="CardHeader" Command="{Binding ToggleGameplayPresetsCommand}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsHitTestVisible="False">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Gameplay presets" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                      <TextBlock Text="Choose a starting point, then fine-tune the six main survival and hazard controls below." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding GameplayPresetsToggleLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <ItemsControl IsVisible="{Binding IsGameplayPresetsExpanded}" ItemsSource="{Binding GameplayDifficultyPresets}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameplayDifficultyPresetViewModel">
                      <Border Classes="PresetCard" Padding="12,9" Margin="0,0,8,6" MinHeight="132">
                        <Grid RowDefinitions="*,Auto" RowSpacing="8">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                            <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Row="1" Content="Use preset" Command="{Binding $parent[Window].DataContext.SelectGameplayPresetCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsVisible="{Binding ShowGameplayCoreControls}">
              <StackPanel Spacing="10">
                <Border Padding="10,8" CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Patch scope" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                      <TextBlock Text="Player only changes the controlled ape. Player + Clan also patches the NPC clan members." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IncludeClanInGameplayPatch}" OnContent="Player + Clan" OffContent="Player only" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <StackPanel Spacing="3">
                  <TextBlock Text="Core survival controls" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{Binding GameplayControlRangeLabel}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding GameplaySimpleControls}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameplayDifficultyControlViewModel">
                      <Border Padding="12,9" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StockValue}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextAlignment="Right" />
                            <NumericUpDown Value="{Binding MultiplierPercent, Mode=TwoWay}" Minimum="{Binding $parent[Window].DataContext.GameplayMinimumPercent}" Maximum="{Binding $parent[Window].DataContext.GameplayMaximumPercent}" Increment="10" FormatString="{}{0}%" Width="118" HorizontalAlignment="Right" IsEnabled="{Binding $parent[Window].DataContext.CanEditGameplay}" />
                            <TextBlock Text="{Binding DraftValue}" FontSize="11" Foreground="{DynamicResource TechnicalTextBrush}" HorizontalAlignment="Right" />
                            <Button Command="{Binding ResetToDefaultCommand}" Content="Reset to 100%" Padding="8,4" HorizontalAlignment="Right" IsEnabled="{Binding $parent[Window].DataContext.CanEditGameplay}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Border>

          <StackPanel IsVisible="{Binding IsGameplayAdvancedMode}" Spacing="12">
            <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsVisible="{Binding IsGameplayRecoveryTab}">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="Recovery &amp; wounds" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="These controls change verified player vitality and wound values. They do not change save data or bypass the normal ability system." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding GameplayAdvancedControls}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameplayDifficultyControlViewModel">
                      <Border Padding="12,9" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StockValue}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextAlignment="Right" />
                            <NumericUpDown Value="{Binding MultiplierPercent, Mode=TwoWay}" Minimum="{Binding $parent[Window].DataContext.GameplayMinimumPercent}" Maximum="{Binding $parent[Window].DataContext.GameplayMaximumPercent}" Increment="10" FormatString="{}{0}%" Width="118" HorizontalAlignment="Right" IsEnabled="{Binding $parent[Window].DataContext.CanEditGameplay}" />
                            <TextBlock Text="{Binding DraftValue}" FontSize="11" Foreground="{DynamicResource TechnicalTextBrush}" HorizontalAlignment="Right" />
                            <Button Command="{Binding ResetToDefaultCommand}" Content="Reset to 100%" Padding="8,4" HorizontalAlignment="Right" IsEnabled="{Binding $parent[Window].DataContext.CanEditGameplay}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsVisible="{Binding IsGameplayResearchTab}">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="Advanced values" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="Technical values with direct static code evidence. They are separate because coupling them casually can create inconsistent vitality, wound or poison behaviour." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding GameplayResearchValues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameplayResearchValueViewModel">
                      <Border Padding="12,9" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <Expander Header="Technical details" FontSize="11" Foreground="{DynamicResource MidTextBrush}" Margin="0,3,0,0">
                              <StackPanel Spacing="2" Margin="0,5,0,0">
                                <TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="{DynamicResource TechnicalTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Editability}" FontSize="11" Foreground="{DynamicResource GoldTextBrush}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Expander>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StockValue}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="Locked research" FontSize="11" Foreground="{DynamicResource TechnicalTextBrush}" HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{Binding GameplayReadiness.AccentBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding GameplayReadiness.Title}" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
              <TextBlock Text="{Binding GameplayReadiness.Description}" FontSize="12" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowProfilesView}" Spacing="16">
          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Profiles" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
                <TextBlock Text="Save, share and review your graphics and future gameplay setup without changing save games." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Import profile" Click="ImportProfileClick" />
                <Button Classes="PrimaryAction" Content="Create profile" Command="{Binding StartCreatingProfileCommand}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="10,8" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding OperationBrush}" BorderThickness="1">
            <TextBlock Text="{Binding OperationMessage}" FontSize="12" Foreground="{Binding OperationBrush}" TextWrapping="Wrap" />
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  IsVisible="{Binding IsCreatingProfile}">
            <StackPanel Spacing="10" MaxWidth="660">
              <TextBlock Text="Create graphics profile" FontWeight="SemiBold" Foreground="{DynamicResource ReviewTextBrush}" />
              <TextBlock Text="This saves the current editable graphics setup, including direct game graphics values. Save games and external mods are never included." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              <TextBlock Text="Set at least one graphics setting to Custom before saving a profile."
                         IsVisible="{Binding !HasCustomProfileSettings}"
                         FontSize="12" Foreground="{DynamicResource GoldTextBrush}" TextWrapping="Wrap" />
              <TextBox PlaceholderText="Profile name" Text="{Binding NewProfileName}" MaxLength="80" />
              <TextBox PlaceholderText="Short description optional" Text="{Binding NewProfileDescription}" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
              <StackPanel Spacing="3">
                <CheckBox IsChecked="True" IsEnabled="False" Content="Graphics settings" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCreatingProfileCommand}" />
                <Button Classes="PrimaryAction" Content="Save profile" Command="{Binding CreateProfileCommand}" IsEnabled="{Binding CanSaveProfile}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  IsVisible="{Binding HasImportedProfile}">
            <StackPanel Spacing="6">
              <TextBlock Text="Imported profile" FontWeight="SemiBold" Foreground="{DynamicResource ReviewTextBrush}" />
              <TextBlock Text="{Binding ImportedProfile.Name}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ImportedProfile.Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ImportedProfile.Contents}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding ImportedProfile.SettingCount, StringFormat={}{0} settings checked}" FontSize="12" Foreground="{DynamicResource LabelTextBrush}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Add to My profiles" Command="{Binding AddImportedProfileToLibraryCommand}" />
                <Button Classes="PrimaryAction" Content="Load for review" Command="{Binding LoadImportedProfileCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  IsVisible="{Binding !HasUserProfiles}">
            <StackPanel Spacing="5">
              <TextBlock Text="No saved profiles yet" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" />
              <TextBlock Text="Create a profile from the current editable graphics setup or import a .aecprofile file. Loaded values are always reviewed before anything is applied." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  IsVisible="{Binding HasProfilePendingRename}">
            <StackPanel Spacing="8" MaxWidth="660">
              <TextBlock Text="Rename profile" FontWeight="SemiBold" Foreground="{DynamicResource ReviewTextBrush}" />
              <TextBlock Text="AEC first writes a validated renamed copy. Only then is the original removed, so a failed write cannot lose the profile." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              <TextBox Text="{Binding RenamedProfileName}" MaxLength="80" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelProfileRenameCommand}" />
                <Button Classes="PrimaryAction" Content="Rename profile" Command="{Binding ConfirmProfileRenameCommand}" IsEnabled="{Binding CanConfirmProfileRename}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                  IsVisible="{Binding HasProfileComparison}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding ProfileComparisonName, StringFormat=Compare: {0}}" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" />
                <Button Grid.Column="1" Content="Close" Command="{Binding ClearProfileComparisonCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <TextBlock Text="Setting" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TechnicalTextBrush}" />
                <TextBlock Grid.Column="1" Text="Current" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TechnicalTextBrush}" />
                <TextBlock Grid.Column="2" Text="Profile" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TechnicalTextBrush}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ProfileComparisonRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileComparisonRowViewModel">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Text="{Binding CurrentValue}" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding ProfileValue}" Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding UserProfiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UserProfileRowViewModel">
                <Border Classes="SettingCard" Padding="14,11" Margin="0,0,0,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Contents}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                      <Button Classes="PrimaryAction" Content="Load profile" Click="LoadStoredProfileClick" />
                      <Expander Header="More" FontSize="12">
                        <StackPanel Spacing="5" Margin="0,6,0,0">
                          <Button Content="Rename" Command="{Binding $parent[Window].DataContext.RequestProfileRenameCommand}" CommandParameter="{Binding}" />
                          <Button Content="Duplicate" Command="{Binding $parent[Window].DataContext.DuplicateProfileCommand}" CommandParameter="{Binding}" />
                          <Button Content="Compare" Command="{Binding $parent[Window].DataContext.CompareProfileCommand}" CommandParameter="{Binding}" />
                          <Button Content="Export" Click="ExportProfileClick" />
                          <Button Classes="DangerAction" Content="Delete" Command="{Binding $parent[Window].DataContext.RequestProfileDeletionCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                    <Border Margin="0,8,0,0" Padding="12,9" CornerRadius="6"
                            Background="{DynamicResource WarningSurfaceBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding IsPendingDeletion}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Delete this profile?" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="This permanently removes this profile from My profiles." FontSize="12" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                          <Button Content="Cancel" Command="{Binding $parent[Window].DataContext.CancelProfileDeletionCommand}" />
                          <Button Classes="DangerAction" Content="Delete profile" Command="{Binding $parent[Window].DataContext.ConfirmProfileDeletionCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowSettingsView}" Spacing="16">
          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
              <TextBlock Text="Accessibility options and maintenance for Ancestors Enhanced Configurator." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                  IsVisible="{Binding HasApplicationPreferencesWarning}">
            <StackPanel Spacing="8">
              <TextBlock Text="Application preferences need attention" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
              <TextBlock Text="{Binding ApplicationPreferencesWarning}" FontSize="12" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
              <TextBlock Text="Reset archives the unreadable file first, then restores AEC's application preferences to safe defaults. This does not change Ancestors, save games, graphics settings or profiles."
                         FontSize="12" Foreground="{DynamicResource GoldTextBrush}" TextWrapping="Wrap" />
              <Button Content="Reset application preferences" Command="{Binding ResetApplicationPreferencesCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Profiles and support" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
                <TextBlock Text="Manage saved graphics setups or open a diagnostic report when something needs troubleshooting." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Manage profiles" Command="{Binding ShowProfilesCommand}" />
                <Button Content="Open diagnostics" Command="{Binding ShowDiagnosticsCommand}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding IsHighContrastEnabled, Mode=TwoWay}"
                            OffContent="Off" OnContent="On"
                            AutomationProperties.Name="Use high contrast mode"
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="High contrast" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Uses brighter text, clearer borders and a visible keyboard focus on AEC's shared surfaces. This does not change Ancestors, your save games or your graphics settings." FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding IsDiscordRichPresenceEnabled, Mode=TwoWay}"
                            OffContent="Off" OnContent="On"
                            AutomationProperties.Name="Share Discord Rich Presence"
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Discord Rich Presence" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Optional. This keeps your preference to use Discord; AEC separately shows whether the local Discord integration actually started. It is off by default." FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DiscordRichPresenceStatus, StringFormat=Status: {0}}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding IsExperimentalGraphicsSettingsEnabled, Mode=TwoWay}"
                            OffContent="Off" OnContent="On"
                            AutomationProperties.Name="Enable experimental graphics settings"
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Enable experimental graphics settings" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Shows 19 additional renderer controls in Graphics › Advanced; it does not change any value by itself. These controls may have little visible effect, need game-specific testing, or trade image quality for performance." FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding IsExperimentalGameplaySettingsEnabled, Mode=TwoWay}"
                            OffContent="Off" OnContent="On"
                            AutomationProperties.Name="Enable experimental gameplay tuning"
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Enable experimental gameplay tuning" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Extends every gameplay percentage control above the normal 10% to 200% range, up to 1000% in 10% steps. This is not a balanced preset range: extreme values can make required portions, damage and healing behave very differently. Simple presets remain within their tested 70% to 150% range." FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  IsVisible="{Binding IsSaveManagerAvailable}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <ToggleSwitch IsChecked="{Binding SaveManager.KeepRunningInTrayWhenClosing, Mode=TwoWay}"
                            IsEnabled="{Binding SaveManager.CanConfigureAutoBackup}"
                            OffContent="Off" OnContent="On"
                            AutomationProperties.Name="Keep running in tray when closing"
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Keep auto-backup running when I close the window" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" />
                <TextBlock Text="When Auto-Backup is enabled, closing AEC hides it in the system tray instead of stopping it. You can open it again or choose Exit from the tray menu." FontSize="12" Foreground="{DynamicResource LabelTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="Ancestors Enhanced maintenance" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
              <TextBlock Text="Remove Configurator changes restores files changed by this Configurator to their state before you first used it. Your save games and other mods are not removed." FontSize="12" Foreground="{DynamicResource GoldTextBrush}" TextWrapping="Wrap" />
              <TextBlock Text="No removable Configurator changes were found." IsVisible="{Binding !HasRemovableToolChanges}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              <Button Command="{Binding RemoveToolChangesCommand}"
                      IsEnabled="{Binding CanRemoveToolChanges}"
                      HorizontalAlignment="Left"
                      Content="Remove Configurator changes"
                      ToolTip.Tip="Shows every unchanged file that will be restored before anything is written." />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowDiagnosticsView}" Spacing="16">
          <Border Classes="SettingCard" Padding="14,11" CornerRadius="7" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" />
                <TextBlock Text="Read-only inspection data for support and conflict triage. Copying the report redacts Windows user paths." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Copy diagnostics" Click="CopyDiagnosticsClick" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Padding="14,11" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
              <TextBlock Text="AEC status" Foreground="{DynamicResource TechnicalTextBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding DetectionStatus}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Installation" Foreground="{DynamicResource TechnicalTextBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstallationDetails}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="System.sav" Foreground="{DynamicResource TechnicalTextBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BinarySettingsStatus}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="System" Foreground="{DynamicResource TechnicalTextBrush}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SystemDiagnostics}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="CPU" Foreground="{DynamicResource TechnicalTextBrush}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HardwareDiagnostics.Cpu}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Text="Memory" Foreground="{DynamicResource TechnicalTextBrush}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HardwareDiagnostics.Memory}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" Text="GPU / VRAM" Foreground="{DynamicResource TechnicalTextBrush}" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding HardwareDiagnostics.Graphics}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="7" Text="Recommendation" Foreground="{DynamicResource TechnicalTextBrush}" />
              <StackPanel Grid.Row="7" Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding HardwareDiagnostics.Recommendation.PresetName}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding HardwareDiagnostics.Recommendation.Description}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <Button Content="{Binding DetailedHardwareActionLabel}" Command="{Binding RunDetailedHardwareDetectionCommand}" IsEnabled="{Binding CanRunDetailedHardwareDetection}" HorizontalAlignment="Left" />
                <Button Content="Stage recommended preset" Command="{Binding LoadHardwareRecommendationCommand}" IsEnabled="{Binding CanStageHardwareRecommendation}" HorizontalAlignment="Left" />
              </StackPanel>
              <TextBlock Grid.Row="8" Text="Hardware status" Foreground="{DynamicResource TechnicalTextBrush}" />
              <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding HardwareDiagnostics.Status}" Foreground="{DynamicResource GoldTextBrush}" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Expander Header="Configuration files">
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ConfigurationFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfigurationFileRowViewModel">
                  <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                    <Grid ColumnDefinitions="170,*,210">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="{DynamicResource MidTextBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <Expander Header="PAK packages">
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding PakFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PakFileRowViewModel">
                  <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                    <Grid ColumnDefinitions="250,180,*">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="{DynamicResource MidTextBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding Classification}" Foreground="{DynamicResource GoldTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <Expander Header="Inspection notes">
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Notices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoticeRowViewModel">
                  <Border Margin="0,0,0,4" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceBrush}">
                    <Grid ColumnDefinitions="90,*">
                      <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="{DynamicResource GoldTextBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Grid.Column="1"
            IsVisible="{Binding ShowBottomBar}"
            Padding="18,12"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <StackPanel IsVisible="{Binding !ShowGameplayView}" Spacing="1">
            <TextBlock Text="{Binding PendingSummary}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BodyTextBrush}" />
            <TextBlock Text="{Binding PendingDetails}"
                       IsVisible="{Binding HasPendingChanges}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource GoldTextBrush}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowGameplayView}" Spacing="1">
            <TextBlock Text="{Binding GameplayDraftStatus}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BodyTextBrush}" />
            <TextBlock Text="{Binding GameplayState.Description}"
                       IsVisible="{Binding HasGameplayPendingChanges}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource GoldTextBrush}" />
          </StackPanel>
          <TextBlock Text="{Binding OperationMessage}"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="{Binding OperationBrush}" />
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Command="{Binding RestoreGameDefaultsCommand}"
                  IsEnabled="{Binding CanRestoreGameDefaults}"
                  IsVisible="{Binding ShowGraphicsView}"
                  Margin="0,0,8,0"
                  Content="Use game graphics settings"
                  ToolTip.Tip="Removes only custom graphics values set in this Configurator. The graphics presets selected in the game will be used again." />
          <Button Command="{Binding RevertLastCommand}"
                  IsEnabled="{Binding CanUndo}"
                  IsVisible="{Binding ShowGraphicsView}"
                  Margin="0,0,8,0"
                  Padding="16,7"
                  Content="Undo last apply" />
          <Button Command="{Binding DiscardChangesCommand}"
                  IsVisible="{Binding ShowPendingActions}"
                  Margin="0,0,8,0"
                  Content="Discard" />
          <Button Command="{Binding OpenReviewCommand}"
                  Classes="PrimaryAction"
                  IsVisible="{Binding ShowPendingActions}"
                  Content="Review" />
          <Button Command="{Binding ResetGameplayCommand}"
                  IsEnabled="{Binding CanResetGameplay}"
                  IsVisible="{Binding ShowGameplayView}"
                  Margin="0,0,8,0"
                  Content="Restore game default"
                  ToolTip.Tip="Removes the AEC gameplay difficulty PAK and restores unmodded game behavior." />
          <Button Command="{Binding OpenGameplayReviewCommand}"
                  Classes="PrimaryAction"
                  IsEnabled="{Binding CanReviewGameplay}"
                  IsVisible="{Binding ShowGameplayView}"
                  Content="{Binding GameplayReviewButtonLabel}" />
        </WrapPanel>
      </Grid>
    </Border>
    </Grid>
    <Grid Grid.ColumnSpan="2"
            x:Name="ReviewOverlay"
            ZIndex="100"
            IsVisible="{Binding IsReviewingChanges}"
            Focusable="True"
            AutomationProperties.Name="Review changes">
      <Grid.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelReviewCommand}" />
      </Grid.KeyBindings>
      <Button Classes="Ghost" Background="{DynamicResource ModalOverlayBrush}"
              Command="{Binding CancelReviewCommand}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Focusable="False"
              IsTabStop="False"
              BorderThickness="0"
              CornerRadius="0"
              Padding="0" />
      <Border x:Name="ReviewDialog"
              MaxWidth="900"
              Margin="20"
              MaxHeight="580"
              Padding="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="9"
              Background="{DynamicResource RaisedSurfaceBrush}"
              BorderBrush="{DynamicResource ReviewBorderBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
          <TextBlock Text="{Binding ReviewSummary}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ReviewTextBrush}" />
          <TextBlock Grid.Row="1"
                     Text="{Binding ReviewDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid ColumnDefinitions="1.2*,1.2*,Auto,1.2*" ColumnSpacing="10" Margin="0,0,0,4">
                <TextBlock Text="Setting" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="Current value" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="3" Text="New value" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ReviewChanges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeReviewRowViewModel">
                  <Border Margin="0,0,0,5" Padding="11" CornerRadius="5" Background="{DynamicResource ReviewSurfaceBrush}">
                    <Grid ColumnDefinitions="1.2*,1.2*,Auto,1.2*" ColumnSpacing="10">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TechnicalKey}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TechnicalTextBrush}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" Foreground="{DynamicResource MidTextBrush}" />
                      <TextBlock Grid.Column="2" Text="→" Foreground="{DynamicResource TechnicalTextBrush}" />
                      <TextBlock Grid.Column="3" Text="{Binding After}" TextWrapping="Wrap" Foreground="{DynamicResource OrangeAccentBrush}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button x:Name="ReviewCancelButton" Command="{Binding CancelReviewCommand}" Content="Cancel" />
            <Button x:Name="ReviewConfirmButton" Command="{Binding ConfirmApplyCommand}" Classes="PrimaryAction" Content="{Binding ConfirmReviewLabel}" />
          </StackPanel>
        </Grid>
        </Border>
    </Grid>
    <Grid Grid.ColumnSpan="2"
          x:Name="OnboardingOverlay"
          ZIndex="110"
          IsVisible="{Binding IsOnboardingVisible}"
          Focusable="True"
          AutomationProperties.Name="Welcome to Ancestors Enhanced">
      <Border Background="{DynamicResource ModalOverlayBrush}" />
      <Border x:Name="OnboardingDialog"
              MaxWidth="650" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="9" Background="{DynamicResource OnboardingPanelBrush}" BorderBrush="{DynamicResource ReviewBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding OnboardingTitle}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ReviewTextBrush}" />
          <TextBlock Text="{Binding OnboardingDescription}" TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}" />
          <TextBlock Text="You can open this Configurator safely: no game files change until you explicitly review and confirm a supported edit." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OnboardingSkipButton" Content="Skip" Command="{Binding SkipOnboardingCommand}" />
            <Button x:Name="OnboardingPrimaryButton" Classes="PrimaryAction" Content="{Binding OnboardingActionLabel}" Command="{Binding AdvanceOnboardingCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.ColumnSpan="2"
             ZIndex="90"
             Background="{DynamicResource DialogScrimBrush}"
             IsVisible="{Binding IsAnyOperationRunning}" />
  </Grid>
</Window>
