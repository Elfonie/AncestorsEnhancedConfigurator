<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\aec-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ThirdParty\Discord\win-x64\discord_partner_sdk.dll"
             Link="discord_partner_sdk.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always"
             Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))" />
    <Content Include="ThirdParty\Discord\linux-x64\libdiscord_partner_sdk.so"
             Link="libdiscord_partner_sdk.so"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always"
             Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))" />
    <Content Include="ThirdParty\Discord\License-Notices.txt"
             Link="Discord-Social-SDK-LICENSE-NOTICES.txt"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AncestorsEnhanced.Core\AncestorsEnhanced.Core.csproj" />
    <ProjectReference Include="..\AncestorsEnhanced.Infrastructure\AncestorsEnhanced.Infrastructure.csproj" />
  </ItemGroup>
</Project>
