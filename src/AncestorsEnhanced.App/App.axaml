<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AncestorsEnhanced.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Application surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0E0B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111713" />
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#161F19" />
    <SolidColorBrush x:Key="BorderBrush" Color="#233027" />
    <!-- Text colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F0F5EE" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#768D7B" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1C261F" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#28362B" />
    <SolidColorBrush x:Key="ControlTextBrush" Color="#C8D6C5" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#223026" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B4D941" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C4E84F" />
    <SolidColorBrush x:Key="FocusBrush" Color="#B4D941" />
    <SolidColorBrush x:Key="FocusGlowBrush" Color="#4DB4D941" />
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#8B481A" />
    <SolidColorBrush x:Key="PrimaryActionBorderBrush" Color="#D8792C" />
    <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#A65720" />
    <SolidColorBrush x:Key="DangerBrush" Color="#3A1917" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#C44A41" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#111C18" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#2B4435" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#A5D6B4" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#241C12" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#765830" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E8D5B5" />
    <!-- Semantic text/surface resources used by page content. Keep these dynamic
         so a high-contrast switch never breaks data-bound status colors. -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1B5A5" />
    <SolidColorBrush x:Key="TechnicalTextBrush" Color="#768D7B" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#B4D941" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#EF5350" />
    <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="#141C16" />
    <SolidColorBrush x:Key="ReviewBorderBrush" Color="#3D5943" />
    <SolidColorBrush x:Key="ReviewTextBrush" Color="#F0F5EE" />
    <!-- Page-level tokens. Every window must reference these via DynamicResource so a
         high-contrast switch re-colors the whole UI; do not hardcode hex values in views.
         Runtime overrides live in AccessibilityTheme.Apply(...). -->
    <SolidColorBrush x:Key="HeadingTextBrush" Color="#F0F5EE" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="#E4EBE2" />
    <SolidColorBrush x:Key="LabelTextBrush" Color="#869D8B" />
    <SolidColorBrush x:Key="MidTextBrush" Color="#869D8B" />
    <SolidColorBrush x:Key="OrangeAccentBrush" Color="#FF9800" />
    <SolidColorBrush x:Key="GoldTextBrush" Color="#E2B45C" />
    <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#EF5350" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#161F19" />
    <SolidColorBrush x:Key="EditorBorderBrush" Color="#28362B" />
    <SolidColorBrush x:Key="OliveBorderBrush" Color="#3B5226" />
    <SolidColorBrush x:Key="CloudWarningBorderBrush" Color="#3B3120" />
    <SolidColorBrush x:Key="OnboardingPanelBrush" Color="#161F19" />
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#E60A0E0B" />
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#1A000000" />
    <LinearGradientBrush x:Key="NavActiveBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#283B20" />
      <GradientStop Offset="1" Color="#162217" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#3B5226" />
      <GradientStop Offset="1" Color="#1E2B14" />
    </LinearGradientBrush>
    <!-- Active ToggleSwitch colors -->
    <SolidColorBrush x:Key="ToggleSwitchCurtainFillOn" Color="#B4D941" />
    <SolidColorBrush x:Key="ToggleSwitchCurtainFillOnPointerOver" Color="#C4E84F" />
    <SolidColorBrush x:Key="ToggleSwitchCurtainStrokeOn" Color="#B4D941" />
    <SolidColorBrush x:Key="ToggleSwitchCurtainStrokeOnPointerOver" Color="#C4E84F" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0A0E0B" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0A0E0B" />
    <!-- Icons as StreamGeometry resources -->
    <StreamGeometry x:Key="IconLeaf">M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A9.49 9.49 0 0 0 17 8zm-7.6 10.74c1.23-2.6 3.73-5.26 6.6-6.74-.82 2.37-2.73 5.3-5.6 6.74z</StreamGeometry>
    <StreamGeometry x:Key="IconHome">M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z</StreamGeometry>
    <StreamGeometry x:Key="IconGraphics">M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 1.99-.9 1.99-2L23 5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z</StreamGeometry>
    <StreamGeometry x:Key="IconSaves">M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z</StreamGeometry>
    <StreamGeometry x:Key="IconGameplay">M7 2v11h3v9l7-12h-4l4-8z</StreamGeometry>
    <StreamGeometry x:Key="IconProfiles">M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
    <StreamGeometry x:Key="IconDiagnostics">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z</StreamGeometry>
    <StreamGeometry x:Key="IconRefresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
    <StreamGeometry x:Key="IconReset">M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z</StreamGeometry>
    <StreamGeometry x:Key="IconStar">M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z</StreamGeometry>
    <StreamGeometry x:Key="IconContrast">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14v12c3.31 0 6-2.69 6-6s-2.69-6-6-6z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Global buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!-- Primary action -->
    <Style Selector="Button.PrimaryAction">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.PrimaryAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrangeAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}" />
    </Style>
    <Style Selector="Button.PrimaryAction:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- Action link for cards (e.g. Open graphics →) -->
    <Style Selector="Button.ActionLink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ActionLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <!-- Destructive / danger -->
    <Style Selector="Button.DangerAction">
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>

    <!-- Sidebar nav buttons -->
    <Style Selector="ToggleButton.nav">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <!-- Active sidebar navigation -->
    <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OliveBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.Ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Card header button: inert, no own hover border/fill. The card shows the hover ring. -->
    <Style Selector="Button.CardHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.CardHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <!-- Mode toggle -->
    <Style Selector="ToggleButton.mode">
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <!-- Active Simple/Advanced mode -->
    <Style Selector="ToggleButton.mode:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="Button:disabled, ToggleButton:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Settings cards -->
    <Style Selector="Border.SettingCard">
      <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Interactive cards add pointer and keyboard-focus feedback. -->
    <Style Selector="Border.SettingCard.InteractiveCard">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.SettingCard.InteractiveCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.SettingCard.InteractiveCard:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    </Style>
    <Style Selector="Border.SettingCard:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <!-- Preset cards are informational surfaces with a contained action. They share
         one visual tier without inheriting the elevation of a whole settings group. -->
    <Style Selector="Border.PresetCard">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    </Style>
    <!-- Inline reset button for sliders and inputs -->
    <Style Selector="Button.InlineReset">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.InlineReset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- KPI Dashboard Card -->
    <Style Selector="Border.KpiCard">
      <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20,18" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.KpiCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Status Pill -->
    <Style Selector="Border.StatusPill">
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,5" />
    </Style>

    <!-- Preset badge card -->
    <Style Selector="Border.PresetTile">
      <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.PresetTile:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Selected Preset Tile -->
    <Style Selector="Border.PresetTile.Selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>

    <!-- Favorite ToggleButton -->
    <Style Selector="ToggleButton.Favorite">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.Favorite:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource GoldTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.Favorite:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>

    <Style Selector="Button:focus-visible, ToggleButton:focus-visible, TextBox:focus-visible, ComboBox:focus-visible, ToggleSwitch:focus-visible, NumericUpDown:focus-visible, CheckBox:focus-visible, Expander:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Application.Styles>
</Application>
