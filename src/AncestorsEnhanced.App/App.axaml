<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AncestorsEnhanced.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Application surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#070907" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121612" />
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#191F19" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A332A" />
    <!-- Text colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8E4D9" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7A877A" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1A221A" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A4A2E" />
    <SolidColorBrush x:Key="ControlTextBrush" Color="#C8CFC4" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#253025" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B4D941" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9ABF31" />
    <SolidColorBrush x:Key="FocusBrush" Color="#B4D941" />
    <SolidColorBrush x:Key="FocusGlowBrush" Color="#66B4D941" />
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#9B3A12" />
    <SolidColorBrush x:Key="PrimaryActionBorderBrush" Color="#C7591C" />
    <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#B54816" />
    <SolidColorBrush x:Key="DangerBrush" Color="#8E2F29" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#C44A41" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#17242B" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#344A56" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#B8D7E5" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#211C18" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#765536" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E8D5B5" />
    <!-- Semantic text/surface resources used by page content. Keep these dynamic
         so a high-contrast switch never breaks data-bound status colors. -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CB0BC" />
    <SolidColorBrush x:Key="TechnicalTextBrush" Color="#71828D" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#B4D941" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#E04D42" />
    <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="#10191F" />
    <SolidColorBrush x:Key="ReviewBorderBrush" Color="#3B7598" />
    <SolidColorBrush x:Key="ReviewTextBrush" Color="#DCEEFF" />
    <!-- Page-level tokens. Every window must reference these via DynamicResource so a
         high-contrast switch re-colors the whole UI; do not hardcode hex values in views.
         Runtime overrides live in AccessibilityTheme.Apply(...). -->
    <SolidColorBrush x:Key="HeadingTextBrush" Color="#EBF0F3" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="#E6ECEF" />
    <SolidColorBrush x:Key="LabelTextBrush" Color="#82939D" />
    <SolidColorBrush x:Key="MidTextBrush" Color="#8B9AA4" />
    <SolidColorBrush x:Key="OrangeAccentBrush" Color="#FF5A00" />
    <SolidColorBrush x:Key="GoldTextBrush" Color="#D6BC84" />
    <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FFF3EA" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#182127" />
    <SolidColorBrush x:Key="EditorBorderBrush" Color="#2A363E" />
    <SolidColorBrush x:Key="OliveBorderBrush" Color="#4A5A23" />
    <SolidColorBrush x:Key="CloudWarningBorderBrush" Color="#3B3120" />
    <SolidColorBrush x:Key="OnboardingPanelBrush" Color="#15232C" />
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#E60C1115" />
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#1A000000" />
    <LinearGradientBrush x:Key="NavActiveBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#4A5A23" />
      <GradientStop Offset="1" Color="#1E2720" />
    </LinearGradientBrush>
    <!-- Active ToggleSwitch colors -->
    <SolidColorBrush x:Key="ToggleSwitchCurtainFillOn" Color="#B4D941" />
    <SolidColorBrush x:Key="ToggleSwitchCurtainFillOnPointerOver" Color="#9ABF31" />
    <SolidColorBrush x:Key="ToggleSwitchCurtainStrokeOn" Color="#B4D941" />
    <SolidColorBrush x:Key="ToggleSwitchCurtainStrokeOnPointerOver" Color="#9ABF31" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#070907" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#070907" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Global buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!-- Primary action -->
    <Style Selector="Button.PrimaryAction">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.PrimaryAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.PrimaryAction:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- Destructive / danger -->
    <Style Selector="Button.DangerAction">
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>

    <!-- Sidebar nav buttons -->
    <Style Selector="ToggleButton.nav">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <!-- Active sidebar navigation -->
    <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.Ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Card header button: inert, no own hover border/fill. The card shows the hover ring. -->
    <Style Selector="Button.CardHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.CardHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <!-- Mode toggle -->
    <Style Selector="ToggleButton.mode">
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Active Simple/Advanced mode -->
    <Style Selector="ToggleButton.mode:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="Button:disabled, ToggleButton:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Settings cards -->
    <Style Selector="Border.SettingCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Interactive cards add pointer and keyboard-focus feedback. -->
    <Style Selector="Border.SettingCard.InteractiveCard">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.SettingCard.InteractiveCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.SettingCard.InteractiveCard:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    </Style>
    <Style Selector="Border.SettingCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <!-- Preset cards are informational surfaces with a contained action. They share
         one visual tier without inheriting the elevation of a whole settings group. -->
    <Style Selector="Border.PresetCard">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <Style Selector="Button:focus-visible, ToggleButton:focus-visible, TextBox:focus-visible, ComboBox:focus-visible, ToggleSwitch:focus-visible, NumericUpDown:focus-visible, CheckBox:focus-visible, Expander:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Application.Styles>
</Application>
